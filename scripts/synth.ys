# yosys synthesis script for Tang Nano 9K (run from repo root: yosys -s scripts/synth.ys)
# read_slang (yosys-slang plugin, bundled in OSS CAD Suite) parses the
# SystemVerilog emitted by Veryl more reliably than read_verilog -sv.
# build/sources.f is generated by build.ps1 from Veryl's filelist (hello_veryl.f),
# so newly added modules are picked up without editing this script.
# src/gowin_prims.sv: 明示インスタンス化する Gowin プリミティブ (IOBUF 等) の
# blackbox スタブ (実体は nextpnr / gowin_pack 側で解決される)
plugin -i slang
read_slang -f build/sources.f src/gowin_prims.sv --top hello_veryl_Top
synth_gowin -json build/top_synth.json
