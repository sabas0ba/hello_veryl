/// PSRAM コントローラ (HyperBus FSM，clk_mem 単一ドメイン．docs/psram.md)
///
/// 初期化 (RESET# パルス → tVCS 待機 → CR0 書き込み → IR0 読み出し自己診断)
/// の後，req/rsp インタフェースの 32bit アクセスを 16bit HyperBus
/// トランザクション 2 回に分割して実行する (単一アウトスタンディング)．
///
/// - レイテンシは固定 2x (CR0[3]=1)．データ位相は CA 3 クロック目立上りを
///   起点に 2*InitialLatency CK 後 (spike 段1 実測 L=0B で確定した起点)
/// - リードは RWDS 修飾のペア検出で語を取り込む．phy の IDDR 取り込みが
///   CK に対しどちらの半サイクルへ載るか (位相依存の半サイクルずれ) に
///   よらず {RWDS=1 の半サンプル, 続く RWDS=0 の半サンプル} を語として
///   組むため，位相調整 (L4 残余⑤) で壊れない
/// - ライトの WSTRB は RWDS マスク (High=マスク) へ写像し，
///   両バイトマスクの半語はトランザクション自体を省略する
/// - 初期化未完了の間は req_ready を落として待たせる．応答は常に完了
///   (エラー応答なし．リードのタイムアウト時は FFFF を返し，初期化中の
///   IR0 照合失敗は o_init_ok=0 として観測する)
pub module PsramCtrl #(
    /// RESET# パルス幅 [cyc] (tRP 200 ns min → 296 ns @54 MHz)
    param ResetPulseCycles: u32 = 16,
    /// RESET# 解除後の待機 [cyc] (tVCS 150 µs min → 200 µs @54 MHz)
    param TvcsCycles: u32 = 10_800,
    /// CR0 に設定する Initial Latency (54 MHz ≤ 83 MHz → 3)
    param InitialLatency: u32 = 3,
    /// CR0 書き込み値 (IL=3, 固定 2x, 他はデフォルト維持)
    param Cr0Value: logic<16> = 16'h8fef,
    /// CR0 書き込みを行うか (0 で POR デフォルト IL=6 のまま動作．L4 切り分け用)
    param WriteCr0: bit = 1,
    /// IR0 期待値 (Winbond / 32 Mbit．spike 段1 実測値)
    param Ir0Expected: logic<16> = 16'h005f,
    /// リード検出ウィンドウ開始 [txn cyc] (CA 期間の RWDS High を誤検出しない下限)
    param DetectStartCyc: u32 = 6,
    /// リード検出打ち切り [txn cyc]
    param TimeoutCyc: u32 = 40,
) (
    i_clk: input clock,
    i_rst: input reset,
    /// 位相イネーブル．1 のサイクルのみ状態更新する (1 サイクル = 1 CK の関係を
    /// 保ったまま SDR fallback phy の 1/4 レートで駆動するため．全速 phy では 1 固定)．
    /// 注意: req/rsp を全速の相手 (CdcHandshake) と結ぶ場合，o_req_ready と
    /// o_rsp_valid は i_en で修飾して渡すこと (非イネーブルサイクルでの
    /// 取りこぼし・二重送信防止．Top の配線参照)
    i_en: input logic,

    // 要求/応答 (単一アウトスタンディング．AXI 側とは async_handshake で結ぶ)
    i_req_valid: input  logic           ,
    o_req_ready: output logic           ,
    i_req      : input  psram_pkg::req_t,
    o_rsp_valid: output logic           ,
    i_rsp_ready: input  logic           ,
    o_rsp      : output psram_pkg::rsp_t,

    // 状態
    o_init_done: output logic, /// 初期化シーケンス完了
    o_init_ok  : output logic, /// IR0 照合成功 (init_done 後に有効)

    // phy SDR インタフェース
    o_ck_en  : output logic   ,
    o_cs_n   : output logic   ,
    o_reset_n: output logic   ,
    o_dq_a   : output logic<8>,
    o_dq_b   : output logic<8>,
    o_dq_oe  : output logic   ,
    o_rwds_a : output logic   ,
    o_rwds_b : output logic   ,
    o_rwds_oe: output logic   ,
    i_dq_a   : input  logic<8>,
    i_dq_b   : input  logic<8>,
    i_rwds_a : input  logic   ,
    i_rwds_b : input  logic   ,
) {
    // トランザクション内タイミング (txn cyc 0 = CS# assert，CA は cyc 1..3)
    const CaStartCyc  : u32 = 1;
    const WrDataCyc   : u32 = CaStartCyc + 2 + 2 * InitialLatency; // 固定 2x
    const RegWrDataCyc: u32 = CaStartCyc + 3; // ゼロレイテンシ
    const GapCycles   : u32 = 2; // tRWR 36 ns / tCSHI

    // レジスタ空間 CA (docs/psram.md「プロトコル仕様」)
    const CaCr0Write: logic<48> = 48'h6000_0100_0000;
    const CaIr0Read : logic<48> = 48'he000_0000_0000;

    // メモリ空間 CA (linear ではなく wrap burst=0．単発 16bit のため差異なし)
    function MemCa (
        we     : input logic    ,
        hb_addr: input logic<21>, /// 16bit ワードアドレス A20-A0
    ) -> logic<48> {
        return {~we, 2'b00, 11'b0, hb_addr[20:9], hb_addr[8:3], 13'b0, hb_addr[2:0]};
    }

    enum State: logic<3> {
        reset_pulse,
        tvcs_wait,
        txn,
        gap,
        idle,
        rsp,
    }

    // シーケンサ: 現在のトランザクションの目的
    enum Seq: logic<2> {
        init_cr0,
        init_ir0,
        op_h0,
        op_h1,
    }

    var state   : State    ;
    var seq     : Seq      ;
    var wait_cnt: logic<16>;
    var cyc     : logic<6> ; // txn 内サイクル
    var gap_cnt : logic<2> ;

    // 現在のトランザクション属性
    var txn_ca     : logic<48>;
    var txn_read   : logic    ;
    var txn_reg_wr : logic    ; // ゼロレイテンシ書き込み
    var txn_wdata  : logic<16>;
    var txn_wmask_a: logic    ; // RWDS High=マスク
    var txn_wmask_b: logic    ;

    // リードのペア検出 (半サンプル列 [prev_b, a, b] を走査)
    var det_p_rwds : logic    ;
    var det_p_dq   : logic<8> ;
    var det_p_valid: logic    ;
    var det_done   : logic    ;
    var det_data   : logic<16>;
    var det_timeout: logic    ;

    // AXI 要求の実行コンテキスト
    var cur_req : psram_pkg::req_t    ;
    var rdata_h0: logic           <16>;
    var rdata_h1: logic           <16>;

    // 半語の要否 (ライトは WSTRB が全 0 の半語を省略，リードは常に両方)
    let need_h1    : logic = if cur_req.we ? cur_req.wstrb[3:2] != 2'b00 : 1'b1;
    let req_need_h0: logic = if i_req.we ? i_req.wstrb[1:0] != 2'b00 : 1'b1;
    let req_need_h1: logic = if i_req.we ? i_req.wstrb[3:2] != 2'b00 : 1'b1;

    assign o_rsp.rdata = {rdata_h1, rdata_h0};

    always_ff (i_clk, i_rst) {
        if_reset {
            state         = State::reset_pulse;
            seq           = Seq::init_cr0;
            wait_cnt      = 0;
            cyc           = 0;
            gap_cnt       = 0;
            txn_ca        = 0;
            txn_read      = 0;
            txn_reg_wr    = 0;
            txn_wdata     = 0;
            txn_wmask_a   = 0;
            txn_wmask_b   = 0;
            det_p_rwds    = 0;
            det_p_dq      = 0;
            det_p_valid   = 0;
            det_done      = 0;
            det_data      = 0;
            det_timeout   = 0;
            cur_req.we    = 0;
            cur_req.addr  = 0;
            cur_req.wdata = 0;
            cur_req.wstrb = 0;
            rdata_h0      = 0;
            rdata_h1      = 0;
            o_req_ready   = 0;
            o_rsp_valid   = 0;
            o_init_done   = 0;
            o_init_ok     = 0;
            o_ck_en       = 0;
            o_cs_n        = 1;
            o_reset_n     = 0;
            o_dq_a        = 0;
            o_dq_b        = 0;
            o_dq_oe       = 0;
            o_rwds_a      = 0;
            o_rwds_b      = 0;
            o_rwds_oe     = 0;
        } else if i_en {
            if state == State::reset_pulse {
                if wait_cnt <: ResetPulseCycles - 1 {
                    wait_cnt = wait_cnt + 1;
                } else {
                    o_reset_n = 1;
                    wait_cnt  = 0;
                    state     = State::tvcs_wait;
                }
            } else if state == State::tvcs_wait {
                if wait_cnt <: TvcsCycles - 1 {
                    wait_cnt = wait_cnt + 1;
                } else if WriteCr0 {
                    // 初期化: CR0 書き込みから開始
                    seq         = Seq::init_cr0;
                    txn_ca      = CaCr0Write;
                    txn_read    = 0;
                    txn_reg_wr  = 1;
                    txn_wdata   = Cr0Value;
                    txn_wmask_a = 0;
                    txn_wmask_b = 0;
                    state       = State::txn;
                    cyc         = 0;
                    o_cs_n      = 0;
                } else {
                    // CR0 書き込みをスキップし IR0 自己診断へ (POR: 固定 2x, IL=6)
                    seq         = Seq::init_ir0;
                    txn_ca      = CaIr0Read;
                    txn_read    = 1;
                    txn_reg_wr  = 0;
                    det_done    = 0;
                    det_timeout = 0;
                    state       = State::txn;
                    cyc         = 0;
                    o_cs_n      = 0;
                }
            } else if state == State::txn {
                cyc = cyc + 1;
                // 既定値 (各サイクルで上書き)
                o_ck_en   = 0;
                o_dq_oe   = 0;
                o_rwds_oe = 0;

                // cyc は旧値 = 「これから始まる wire サイクル - 1」．
                // CA は wire サイクル 1..3 (旧値 0..2 のエッジで駆動)
                if cyc <: CaStartCyc + 2 {
                    o_ck_en = 1;
                    o_dq_oe = 1;
                }
                o_dq_a = case cyc {
                    0      : txn_ca[47:40],
                    1      : txn_ca[31:24],
                    2      : txn_ca[15:8],
                    default: 8'h00,
                };
                o_dq_b = case cyc {
                    0      : txn_ca[39:32],
                    1      : txn_ca[23:16],
                    2      : txn_ca[7:0],
                    default: 8'h00,
                };

                if txn_reg_wr {
                    // ゼロレイテンシ書き込み: cyc4 でデータ 1 語
                    if cyc == RegWrDataCyc - 1 {
                        o_ck_en = 1;
                        o_dq_oe = 1;
                        o_dq_a  = txn_wdata[15:8];
                        o_dq_b  = txn_wdata[7:0];
                    } else if cyc == RegWrDataCyc {
                        o_cs_n  = 1;
                        state   = State::gap;
                        gap_cnt = 0;
                    }
                } else if !txn_read {
                    // メモリライト (固定 2x レイテンシ)
                    if cyc >: CaStartCyc + 1 && cyc <: WrDataCyc - 1 {
                        o_ck_en = 1; // レイテンシクロック (wire 4..WrDataCyc-1)
                    }
                    if cyc == WrDataCyc - 1 {
                        o_ck_en   = 1;
                        o_dq_oe   = 1;
                        o_dq_a    = txn_wdata[15:8];
                        o_dq_b    = txn_wdata[7:0];
                        o_rwds_oe = 1;
                        o_rwds_a  = txn_wmask_a;
                        o_rwds_b  = txn_wmask_b;
                    } else if cyc == WrDataCyc {
                        o_cs_n  = 1;
                        state   = State::gap;
                        gap_cnt = 0;
                    }
                } else {
                    // リード: RWDS 修飾のペア検出まで CK を回す
                    if !det_done {
                        o_ck_en = 1;
                    }
                    if cyc >: DetectStartCyc - 1 && !det_done {
                        if det_p_valid && det_p_rwds && !i_rwds_a {
                            det_data = {det_p_dq, i_dq_a};
                            det_done = 1;
                        } else if i_rwds_a && !i_rwds_b {
                            det_data = {i_dq_a, i_dq_b};
                            det_done = 1;
                        } else if cyc == TimeoutCyc {
                            det_data    = '1;
                            det_timeout = 1;
                            det_done    = 1;
                        }
                        det_p_rwds  = i_rwds_b;
                        det_p_dq    = i_dq_b;
                        det_p_valid = 1;
                    }
                    if det_done {
                        // 1 サイクル置いて CS# を上げる
                        o_cs_n  = 1;
                        state   = State::gap;
                        gap_cnt = 0;
                    }
                }
            } else if state == State::gap {
                // トランザクション間の CS# High (tRWR / tCSHI)
                det_p_valid = 0;
                det_p_rwds  = 0;
                if gap_cnt <: GapCycles - 1 {
                    gap_cnt = gap_cnt + 1;
                } else if seq == Seq::init_cr0 {
                    // 次: IR0 読み出し (自己診断)
                    seq         = Seq::init_ir0;
                    txn_ca      = CaIr0Read;
                    txn_read    = 1;
                    txn_reg_wr  = 0;
                    det_done    = 0;
                    det_timeout = 0;
                    state       = State::txn;
                    cyc         = 0;
                    o_cs_n      = 0;
                } else if seq == Seq::init_ir0 {
                    o_init_ok   = det_data == Ir0Expected && !det_timeout;
                    o_init_done = 1;
                    o_req_ready = 1;
                    state       = State::idle;
                } else if seq == Seq::op_h0 {
                    if txn_read {
                        rdata_h0 = det_data;
                    }
                    if need_h1 {
                        seq         = Seq::op_h1;
                        txn_ca      = MemCa(cur_req.we, {cur_req.addr, 1'b1});
                        txn_read    = ~cur_req.we;
                        txn_reg_wr  = 0;
                        txn_wdata   = cur_req.wdata[31:16];
                        txn_wmask_a = ~cur_req.wstrb[3];
                        txn_wmask_b = ~cur_req.wstrb[2];
                        det_done    = 0;
                        det_timeout = 0;
                        state       = State::txn;
                        cyc         = 0;
                        o_cs_n      = 0;
                    } else {
                        state       = State::rsp;
                        o_rsp_valid = 1;
                    }
                } else { // Seq::op_h1
                    if txn_read {
                        rdata_h1 = det_data;
                    }
                    state       = State::rsp;
                    o_rsp_valid = 1;
                }
            } else if state == State::idle {
                if i_req_valid && o_req_ready {
                    cur_req     = i_req;
                    o_req_ready = 0;
                    // 半語 0 から実行 (ライトで両半語マスクなら即応答)
                    if req_need_h0 {
                        seq         = Seq::op_h0;
                        txn_ca      = MemCa(i_req.we, {i_req.addr, 1'b0});
                        txn_read    = ~i_req.we;
                        txn_reg_wr  = 0;
                        txn_wdata   = i_req.wdata[15:0];
                        txn_wmask_a = ~i_req.wstrb[1];
                        txn_wmask_b = ~i_req.wstrb[0];
                        det_done    = 0;
                        det_timeout = 0;
                        state       = State::txn;
                        cyc         = 0;
                        o_cs_n      = 0;
                    } else if req_need_h1 {
                        seq         = Seq::op_h1;
                        txn_ca      = MemCa(i_req.we, {i_req.addr, 1'b1});
                        txn_read    = ~i_req.we;
                        txn_reg_wr  = 0;
                        txn_wdata   = i_req.wdata[31:16];
                        txn_wmask_a = ~i_req.wstrb[3];
                        txn_wmask_b = ~i_req.wstrb[2];
                        det_done    = 0;
                        det_timeout = 0;
                        state       = State::txn;
                        cyc         = 0;
                        o_cs_n      = 0;
                    } else {
                        state       = State::rsp;
                        o_rsp_valid = 1;
                    }
                }
            } else { // State::rsp
                if o_rsp_valid && i_rsp_ready {
                    o_rsp_valid = 0;
                    o_req_ready = 1;
                    state       = State::idle;
                }
            }
        }
    }
}
