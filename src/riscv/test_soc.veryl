// RvSoc の L1 テスト (docs/riscv.md パッチ計画 #6, #7, #8)
//
// ブート ROM の software/hello.S をコアが実行し，
//   1. UART へ挨拶を 1 行送出
//   2. PSRAM へ 64 語のパターンを書いて読み返し照合し結果を 1 行送出
//   3. M 拡張 (乗除算) の代表値とゼロ除算の規定値を確認し結果を 1 行送出
//   4. LED 点灯
// までを確認する．
//
// PSRAM は AxiLiteMemModel で代替する（実 PSRAM のタイミングは
// PSRAM サブシステム側のテストで担保済み）．UART も stream_if を即受理して
// ボーレート待ちを省く（実 UART のタイミングは UART テストで担保済み）．

#[test(test_rv_soc)]
module test_rv_soc {
    const MaxCycles: u32 = 400_000;
    // "Hello from the RV32I core on Tang Nano 9K!\r\n" (44)
    // + "PSRAM OK\r\n" (10) + "MULDIV OK\r\n" (11)
    const MsgLen: u32 = 65;
    // hello.S の TEST_WORDS と一致させる
    const TestWords: u32 = 64;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst tx    : stream_if;
    inst rx    : stream_if;
    inst ps_axi: $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>;

    assign ps_axi.awid = 0;
    assign ps_axi.arid = 0;

    var leds        : logic<6> ;
    var tohost_valid: logic    ;
    var _tohost     : logic<32>;
    var _pc         : logic<32>;
    var _trap       : logic    ;
    var _cause      : logic<32>;
    var illegal     : logic    ;

    inst dut: RvSoc #(
        RamWords: 64,
    ) (
        i_clk         : clk         ,
        i_rst         : rst         ,
        tx            : tx          ,
        rx            : rx          ,
        m_psram       : ps_axi      ,
        o_leds        : leds        ,
        o_tohost_valid: tohost_valid,
        o_tohost      : _tohost     ,
        o_pc          : _pc         ,
        o_trap        : _trap       ,
        o_cause       : _cause      ,
        o_illegal     : illegal     ,
    );

    var _dbg_data: logic<32>;
    var wr_count : logic<16>;
    var rd_count : logic<16>;

    inst psram: AxiLiteMemModel #(
        Words: TestWords,
    ) (
        i_clk      : clk      ,
        i_rst      : rst      ,
        s_axi      : ps_axi   ,
        i_dbg_word : 0        ,
        i_dbg_we   : 0        ,
        i_dbg_wdata: 0        ,
        o_dbg_data : _dbg_data,
        o_wr_count : wr_count ,
        o_rd_count : rd_count ,
    );

    var got      : logic<8> [80];
    var n        : logic<7>     ;
    var leds_seen: logic        ;

    initial {
        n          = 0;
        leds_seen  = 0;
        tx.ready   = 1;
        rx.valid   = 0;
        rx.data    = 0;
        rst.assert();

        for _c in 0..MaxCycles {
            if tx.valid == 1'b1 && tx.ready == 1'b1 && n <: MsgLen {
                got[n] = tx.data;
                n      = n + 1;
            }
            if leds == 6'h3f {
                leds_seen = 1;
            }
            clk.next(1);
        }

        $assert_continue(illegal == 1'b0, "未定義命令に落ちていない");
        $assert_continue(n == MsgLen, "送出バイト数");

        // 1 行目の先頭 "Hello "
        $assert_continue(got[0] == 8'h48, "'H'");
        $assert_continue(got[1] == 8'h65, "'e'");
        $assert_continue(got[2] == 8'h6c, "'l'");
        $assert_continue(got[3] == 8'h6c, "'l'");
        $assert_continue(got[4] == 8'h6f, "'o'");
        $assert_continue(got[5] == 8'h20, "' '");
        // 1 行目の末尾 "9K!" + CR LF
        $assert_continue(got[39] == 8'h39, "'9'");
        $assert_continue(got[40] == 8'h4b, "'K'");
        $assert_continue(got[41] == 8'h21, "'!'");
        $assert_continue(got[42] == 8'h0d, "CR");
        $assert_continue(got[43] == 8'h0a, "LF");
        // 2 行目 "PSRAM OK"．照合が失敗していれば 'N' 'G' になる
        $assert_continue(got[44] == 8'h50, "'P'");
        $assert_continue(got[45] == 8'h53, "'S'");
        $assert_continue(got[46] == 8'h52, "'R'");
        $assert_continue(got[47] == 8'h41, "'A'");
        $assert_continue(got[48] == 8'h4d, "'M'");
        $assert_continue(got[49] == 8'h20, "' '");
        $assert_continue(got[50] == 8'h4f, "PSRAM 照合結果 'O'");
        $assert_continue(got[51] == 8'h4b, "PSRAM 照合結果 'K'");
        $assert_continue(got[52] == 8'h0d, "CR");
        $assert_continue(got[53] == 8'h0a, "LF");
        // 3 行目 "MULDIV OK"．乗除算の照合が失敗していれば 'N' 'G' になる
        $assert_continue(got[54] == 8'h4d, "'M'");
        $assert_continue(got[55] == 8'h55, "'U'");
        $assert_continue(got[56] == 8'h4c, "'L'");
        $assert_continue(got[57] == 8'h44, "'D'");
        $assert_continue(got[58] == 8'h49, "'I'");
        $assert_continue(got[59] == 8'h56, "'V'");
        $assert_continue(got[60] == 8'h20, "' '");
        $assert_continue(got[61] == 8'h4f, "乗除算の照合結果 'O'");
        $assert_continue(got[62] == 8'h4b, "乗除算の照合結果 'K'");
        $assert_continue(got[63] == 8'h0d, "CR");
        $assert_continue(got[64] == 8'h0a, "LF");

        // PSRAM への実アクセス回数（書き込みと読み返しで各 TestWords 回）
        $assert_continue(wr_count == TestWords, "PSRAM ライト回数");
        $assert_continue(rd_count == TestWords, "PSRAM リード回数");

        // 送出後に LED 全点灯へ進む
        $assert_continue(leds_seen == 1'b1, "LED 全点灯へ到達");
        $assert_continue(tohost_valid == 1'b0, "TOHOST は使っていない");

        $finish();
    }
}
