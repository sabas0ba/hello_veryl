    /// テスト id とワード番号からプログラム語を引く
    function Word (
        id : input logic<8> ,
        idx: input logic<16>,
    ) -> logic<32> {
        return case id {
            0      : T0(idx),
            1      : T1(idx),
            2      : T2(idx),
            3      : T3(idx),
            4      : T4(idx),
            5      : T5(idx),
            6      : T6(idx),
            7      : T7(idx),
            8      : T8(idx),
            9      : T9(idx),
            10     : T10(idx),
            11     : T11(idx),
            12     : T12(idx),
            13     : T13(idx),
            14     : T14(idx),
            15     : T15(idx),
            16     : T16(idx),
            17     : T17(idx),
            18     : T18(idx),
            19     : T19(idx),
            20     : T20(idx),
            21     : T21(idx),
            22     : T22(idx),
            23     : T23(idx),
            24     : T24(idx),
            25     : T25(idx),
            26     : T26(idx),
            27     : T27(idx),
            28     : T28(idx),
            29     : T29(idx),
            30     : T30(idx),
            31     : T31(idx),
            32     : T32(idx),
            33     : T33(idx),
            34     : T34(idx),
            35     : T35(idx),
            36     : T36(idx),
            37     : T37(idx),
            38     : T38(idx),
            39     : T39(idx),
            40     : T40(idx),
            41     : T41(idx),
            42     : T42(idx),
            43     : T43(idx),
            44     : T44(idx),
            45     : T45(idx),
            46     : T46(idx),
            47     : T47(idx),
            default: 32'h00000000,
        };
    }
}
