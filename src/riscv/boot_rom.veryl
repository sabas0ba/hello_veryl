// ソフトコアのブートプログラム (ROM イメージ)
// scripts/gen_riscv_boot.py が build/software/hello.bin から生成する．手で編集しない．
// 元のソースは software/hello.S，逆アセンブルは build/software/hello.dis．

pub package RvBootRom {
    /// プログラムのワード数
    const Words: u32 = 34;

    /// ワード 0..33
    function C0 (
        idx: input logic<16>,
    ) -> logic<32> {
        return case idx {
            0      : 32'h00000417,
            1      : 32'h05840413,
            2      : 32'h200004b7,
            3      : 32'h01048493,
            4      : 32'h00044503,
            5      : 32'h00050e63,
            6      : 32'h0004a583,
            7      : 32'h0015f593,
            8      : 32'hfe058ce3,
            9      : 32'h00a4a023,
            10     : 32'h00140413,
            11     : 32'hfe5ff06f,
            12     : 32'h200002b7,
            13     : 32'h02028293,
            14     : 32'h03f00313,
            15     : 32'h0062a023,
            16     : 32'h03f34313,
            17     : 32'h000f43b7,
            18     : 32'h24038393,
            19     : 32'hfff38393,
            20     : 32'hfe039ee3,
            21     : 32'hfe9ff06f,
            22     : 32'h6c6c6548,
            23     : 32'h7266206f,
            24     : 32'h74206d6f,
            25     : 32'h52206568,
            26     : 32'h49323356,
            27     : 32'h726f6320,
            28     : 32'h6e6f2065,
            29     : 32'h6e615420,
            30     : 32'h614e2067,
            31     : 32'h39206f6e,
            32     : 32'h0a0d214b,
            33     : 32'h00000000,
            default: 32'h00000000,
        };
    }

    /// ワード番号からプログラム語を引く
    function Word (
        idx: input logic<16>,
    ) -> logic<32> {
        return C0(idx);
    }
}
