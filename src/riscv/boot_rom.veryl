// ソフトコアのブートプログラム (ROM イメージ)
// scripts/gen_riscv_boot.py が build/software/hello.bin から生成する．手で編集しない．
// 元のソースは software/hello.S，逆アセンブルは build/software/hello.dis．

pub package RvBootRom {
    /// プログラムのワード数
    const Words: u32 = 70;

    /// ワード 0..69
    function C0 (
        idx: input logic<16>,
    ) -> logic<32> {
        return case idx {
            0      : 32'h00000517,
            1      : 32'h0d450513,
            2      : 32'h0a0000ef,
            3      : 32'h100002b7,
            4      : 32'h04000313,
            5      : 32'h00000393,
            6      : 32'h12345e37,
            7      : 32'h678e0e13,
            8      : 32'h00239e93,
            9      : 32'h01d28eb3,
            10     : 32'h007e4f33,
            11     : 32'h01eea023,
            12     : 32'h00138393,
            13     : 32'hfe63c6e3,
            14     : 32'h00000393,
            15     : 32'h00000913,
            16     : 32'h00239e93,
            17     : 32'h01d28eb3,
            18     : 32'h000eaf83,
            19     : 32'h007e4f33,
            20     : 32'h01ef8463,
            21     : 32'h00190913,
            22     : 32'h00138393,
            23     : 32'hfe63c2e3,
            24     : 32'h00090a63,
            25     : 32'h00000517,
            26     : 32'h0a850513,
            27     : 32'h03c000ef,
            28     : 32'h0100006f,
            29     : 32'h00000517,
            30     : 32'h08d50513,
            31     : 32'h02c000ef,
            32     : 32'h200009b7,
            33     : 32'h02098993,
            34     : 32'h03f00a13,
            35     : 32'h0149a023,
            36     : 32'h03fa4a13,
            37     : 32'h000f4ab7,
            38     : 32'h240a8a93,
            39     : 32'hfffa8a93,
            40     : 32'hfe0a9ee3,
            41     : 32'hfe9ff06f,
            42     : 32'h20000637,
            43     : 32'h01060613,
            44     : 32'h00054583,
            45     : 32'h00058e63,
            46     : 32'h00062683,
            47     : 32'h0016f693,
            48     : 32'hfe068ce3,
            49     : 32'h00b62023,
            50     : 32'h00150513,
            51     : 32'hfe5ff06f,
            52     : 32'h00008067,
            53     : 32'h6c6c6548,
            54     : 32'h7266206f,
            55     : 32'h74206d6f,
            56     : 32'h52206568,
            57     : 32'h49323356,
            58     : 32'h726f6320,
            59     : 32'h6e6f2065,
            60     : 32'h6e615420,
            61     : 32'h614e2067,
            62     : 32'h39206f6e,
            63     : 32'h0a0d214b,
            64     : 32'h52535000,
            65     : 32'h4f204d41,
            66     : 32'h000a0d4b,
            67     : 32'h41525350,
            68     : 32'h474e204d,
            69     : 32'h00000a0d,
            default: 32'h00000000,
        };
    }

    /// ワード番号からプログラム語を引く
    function Word (
        idx: input logic<16>,
    ) -> logic<32> {
        return C0(idx);
    }
}
