// ソフトコアのブートプログラム (ROM イメージ)
// scripts/gen_riscv_boot.py が build/software/hello.bin から生成する．手で編集しない．
// 元のソースは software/hello.S，逆アセンブルは build/software/hello.dis．

pub package RvBootRom {
    /// プログラムのワード数
    const Words: u32 = 108;

    /// ワード 0..107
    function C0 (
        idx: input logic<16>,
    ) -> logic<32> {
        return case idx {
            0      : 32'h00000517,
            1      : 32'h15450513,
            2      : 32'h120000ef,
            3      : 32'h100002b7,
            4      : 32'h04000313,
