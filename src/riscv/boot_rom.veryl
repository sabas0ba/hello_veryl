            9      : 32'h01d28eb3,
            10     : 32'h007e4f33,
            11     : 32'h01eea023,
            12     : 32'h00138393,
            13     : 32'hfe63c6e3,
            14     : 32'h00000393,
            15     : 32'h00000913,
            16     : 32'h00239e93,
            17     : 32'h01d28eb3,
            18     : 32'h000eaf83,
            19     : 32'h007e4f33,
            20     : 32'h01ef8463,
            21     : 32'h00190913,
            22     : 32'h00138393,
            23     : 32'hfe63c2e3,
            24     : 32'h00090a63,
            25     : 32'h00000517,
            26     : 32'h12850513,
            27     : 32'h0bc000ef,
            28     : 32'h0900006f,
            29     : 32'h00000517,
            30     : 32'h10d50513,
            31     : 32'h0ac000ef,
            32     : 32'h0001e2b7,
            33     : 32'h24028293,
            34     : 32'h00002337,
            35     : 32'hed330313,
            36     : 32'h026283b3,
            37     : 32'h3a110e37,
            38     : 32'hac0e0e13,
            39     : 32'h05c39c63,
            40     : 32'h0263ceb3,
            41     : 32'h045e9863,
            42     : 32'hc1800293,
            43     : 32'h00300313,
            44     : 32'h0262c3b3,
            45     : 32'heb300e13,
            46     : 32'h03c39e63,
            47     : 32'h0262e3b3,
            48     : 32'hfff00e13,
            49     : 32'h03c39863,
            50     : 32'h00000313,
            51     : 32'h0262c3b3,
            52     : 32'hfff00e13,
            53     : 32'h03c39063,
            54     : 32'h0262e3b3,
            55     : 32'hc1800e13,
            56     : 32'h01c39a63,
            57     : 32'h00000517,
            58     : 32'h0b350513,
            59     : 32'h03c000ef,
            60     : 32'h0100006f,
            61     : 32'h00000517,
            62     : 32'h0af50513,
            63     : 32'h02c000ef,
            64     : 32'h200009b7,
            65     : 32'h02098993,
            66     : 32'h03f00a13,
            67     : 32'h0149a023,
            68     : 32'h03fa4a13,
            69     : 32'h000f4ab7,
            70     : 32'h240a8a93,
            71     : 32'hfffa8a93,
            72     : 32'hfe0a9ee3,
            73     : 32'hfe9ff06f,
            74     : 32'h20000637,
            75     : 32'h01060613,
            76     : 32'h00054583,
            77     : 32'h00058e63,
            78     : 32'h00062683,
            79     : 32'h0016f693,
            80     : 32'hfe068ce3,
            81     : 32'h00b62023,
            82     : 32'h00150513,
            83     : 32'hfe5ff06f,
            84     : 32'h00008067,
            85     : 32'h6c6c6548,
            86     : 32'h7266206f,
            87     : 32'h74206d6f,
            88     : 32'h52206568,
            89     : 32'h49323356,
            90     : 32'h726f6320,
            91     : 32'h6e6f2065,
            92     : 32'h6e615420,
            93     : 32'h614e2067,
            94     : 32'h39206f6e,
            95     : 32'h0a0d214b,
            96     : 32'h52535000,
            97     : 32'h4f204d41,
            98     : 32'h000a0d4b,
            99     : 32'h41525350,
            100    : 32'h474e204d,
            101    : 32'h4d000a0d,
            102    : 32'h49444c55,
            103    : 32'h4b4f2056,
            104    : 32'h4d000a0d,
            105    : 32'h49444c55,
            106    : 32'h474e2056,
            107    : 32'h00000a0d,
            default: 32'h00000000,
        };
    }

    /// ワード番号からプログラム語を引く
    function Word (
        idx: input logic<16>,
    ) -> logic<32> {
        return C0(idx);
    }
}
