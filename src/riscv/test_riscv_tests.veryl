// riscv-tests (rv32ui) のランナー (docs/riscv.md「検証」)
//
// L2: 実装から独立した外部オラクル．L1 (自作テスト) は自作モデルと DUT が
// 同じ命令解釈を共有するため共通モード誤りを検出できないが，riscv-tests は
// 実装と独立に書かれているため命令解釈の誤りを反証できる．
//
// プログラムは scripts/gen_riscv_rom.py が build/riscv_tests/*.bin から生成した
// RvTestImg から供給する．テスト番号と名前の対応は src/riscv/test_rom.veryl の
// 先頭コメントにある．
//
// 終了規約は riscv-tests と同じで，MMIO_TOHOST (0x2000_0000) へのストア値が
// 1 なら pass，それ以外は (テスト番号 << 1) | 1 で失敗したテスト番号を示す
// (verif/riscv/env/riscv_test.h)．

#[test(test_riscv_tests)]
module test_riscv_tests {
    const MaxCycles: u32       = 100_000;
    const ToHost   : logic<32> = 32'h2000_0000;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var mem_valid: logic    ;
    var mem_addr : logic<32>;
    var mem_write: logic    ;
    var mem_wdata: logic<32>;
    var mem_wstrb: logic<4> ;
    var mem_done : logic    ;
    var mem_rdata: logic<32>;

    var dbg_we   : logic    ;
    var dbg_word : logic<32>;
    var dbg_wdata: logic<32>;

    var pc     : logic<32>;
    var _trap  : logic    ;
    var _cause : logic<32>;
    var illegal: logic    ;

    inst core: RvCore (
        i_clk      : clk      ,
        i_rst      : rst      ,
        o_mem_valid: mem_valid,
        o_mem_addr : mem_addr ,
        o_mem_write: mem_write,
        o_mem_wdata: mem_wdata,
        o_mem_wstrb: mem_wstrb,
        i_mem_done : mem_done ,
        i_mem_rdata: mem_rdata,
        i_timer_irq: 1'b0     ,
        o_pc       : pc       ,
        o_trap     : _trap    ,
        o_cause    : _cause   ,
        o_illegal  : illegal  ,
    );

    // 1024 語 = 4 KB．最大のテスト (ld_st, 968 語) と署名領域を収める
    inst mem: RvMem #(
        Words: 1024,
    ) (
        i_clk      : clk      ,
        i_rst      : rst      ,
        i_valid    : mem_valid,
        i_addr     : mem_addr ,
        i_write    : mem_write,
        i_wdata    : mem_wdata,
        i_wstrb    : mem_wstrb,
        o_done     : mem_done ,
        o_rdata    : mem_rdata,
        i_dbg_we   : dbg_we   ,
        i_dbg_word : dbg_word ,
        i_dbg_wdata: dbg_wdata,
    );

    var tid   : logic<8> ;
    var len   : logic<16>;
    var tohost: logic<32>;
    var got   : logic    ;
    var fails : logic<8> ;

    initial {
        fails     = 0;
        dbg_we    = 0;
        dbg_word  = 0;
        dbg_wdata = 0;
        tid       = 0;

        for t in 0..RvTestImg::Count {
            tid        = t;
            rst.assert();

            // プログラムをプリロードする (この間コアの要求は受理されない)
            len    = RvTestImg::Len(tid);
            dbg_we = 1;
            for i in 0..RvTestImg::MaxWords {
                if i <: len {
                    dbg_word  = i;
                    dbg_wdata = RvTestImg::Word(tid, i);
                    clk.next (1);
                }
            }
            dbg_we = 0;

            // 実行し，MMIO_TOHOST へのストアで終了を判定する
            got    = 0;
            tohost = 0;
            for _c in 0..MaxCycles {
                if mem_done == 1'b1 && mem_write == 1'b1 && mem_addr == ToHost {
                    tohost = mem_wdata;
                    got    = 1;
                    break;
                }
                clk.next(1);
            }

            // 不正命令例外はテストが意図して起こすことがある (illegal.S) ため，
            // ここでは終了判定に使わない
            if got == 1'b0 {
                $display("riscv-test %d: タイムアウト (pc=%h)", tid, pc);
                fails    = fails + 1;
            } else if tohost != 32'h1 {
                $display("riscv-test %d: FAIL tohost=%h (失敗したサブテスト番号 = tohost>>1)", tid, tohost);
                fails    = fails + 1;
            }
        }

        $display        ("riscv-tests: %d / %d 本が失敗", fails, RvTestImg::Count);
        $assert_continue(fails == 8'd0, "riscv-tests (rv32ui)");
        $finish         ();
    }
}
