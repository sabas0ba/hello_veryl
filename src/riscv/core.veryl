/// RV32I 多サイクルコア (docs/riscv.md「マイクロアーキテクチャ」)
///
/// 1 命令を fetch → exec（→ mem）で処理する非パイプライン実装．
/// メモリが律速（PSRAM 実効 2.25 MB/s = 約 0.56 MIPS）でパイプライン化の
/// 利得が小さく，面積が最小で，1 命令 = 1 トランザクション境界という性質が
/// L1 検証を単純にする．
///
/// ```mermaid
/// stateDiagram-v2
///     [*] --> fetch
///     fetch --> rdreg: 命令語受領
///     rdreg --> exec: レジスタ読み出し確定
///     exec --> memacc: load / store
///     exec --> mdwait: 乗除算 (M 拡張)
///     exec --> fetch: それ以外（分岐・ジャンプ・MRET 含む）
///     memacc --> fetch: 完了
///     mdwait --> fetch: 完了
/// ```
///
/// `rdreg` はレジスタファイルの読み出しレイテンシ（1 サイクル）を吸収する
/// ための待ち状態．レジスタファイルをメモリマクロへ寄せて LUT を削った
/// 代償だが，多サイクル実行なので状態を 1 つ足すだけで済む
/// （パイプラインならフォワーディングの再設計が要る．docs/riscv.md）．
///
/// 分岐条件の比較はコア内の専用比較器で行う（ALU は分岐先アドレスの
/// 計算に使うため）．JALR の分岐先は仕様どおり最下位ビットを 0 にする．
///
/// トラップ（不正命令・ECALL・EBREAK・ロード/ストアの非整列・命令フェッチの
/// 非整列・タイマ割り込み）は，どの状態からでも実行を打ち切って `mtvec` へ飛ぶ．
/// `mepc` / `mcause` / `mtval` の退避と `mstatus` の更新は `RvCsr` 側で行う．
/// 割り込みは命令境界（フェッチ開始前）でのみ受理する．
/// `o_illegal` は不正命令例外を 1 度でも起こしたことを示す診断用の粘着フラグ．
pub module RvCore #(
    /// リセット後の開始アドレス
    param ResetPc: u32 = 0,
) (
    i_clk: input clock, /// クロック
    i_rst: input reset, /// リセット

    // メモリ IF（RvMem のプロトコル）
    o_mem_valid: output logic    , /// アクセス要求
    o_mem_addr : output logic<32>, /// バイトアドレス
    o_mem_write: output logic    , /// 1 でストア
    o_mem_wdata: output logic<32>, /// ストアデータ（整列済み）
    o_mem_wstrb: output logic<4> , /// バイトイネーブル
    i_mem_done : input  logic    , /// 完了
    i_mem_rdata: input  logic<32>, /// リードデータ

    i_timer_irq: input logic, /// CLINT からのタイマ割り込み

    o_pc     : output logic<32>, /// 現在の PC（観測用）
    o_trap   : output logic    , /// トラップ受理（1 サイクル．観測用）
    o_cause  : output logic<32>, /// 受理したトラップの原因（観測用）
    o_illegal: output logic    , /// 不正命令例外を 1 度でも起こした（診断用）
) {
    enum State: logic<3> {
        fetch,
        rdreg,
        exec,
        memacc,
        mdwait,
    }

    var state: State    ;
    var pc   : logic<32>;
    var iw   : logic<32>; // 実行中の命令語

    // ---- デコード（組合せ）----
    var dec: RvPkg::Decoded;

    inst decoder: RvDecoder (
        i_inst: iw ,
        o_dec : dec,
    );

    // ---- レジスタファイル ----
    var rf_we   : logic    ;
    var rf_wdata: logic<32>;
    var rd1     : logic<32>;
    var rd2     : logic<32>;

    inst regfile: RvRegFile (
        i_clk            ,
        i_rst            ,
        i_rs1  : dec.rs1 ,
        o_rd1  : rd1     ,
        i_rs2  : dec.rs2 ,
        o_rd2  : rd2     ,
        i_we   : rf_we   ,
        i_rd   : dec.rd  ,
        i_wdata: rf_wdata,
    );

    // ---- ALU ----
    let alu_a: logic<32> = if dec.src_a == RvPkg::SrcA::pc ? pc : rd1;
    let alu_b: logic<32> = if dec.src_b == RvPkg::SrcB::imm ? dec.imm : rd2;
    var alu_y: logic<32>;

    inst alu: RvAlu (
        i_op: dec.alu_op,
        i_a : alu_a     ,
        i_b : alu_b     ,
        o_y : alu_y     ,
    );

    // ---- 分岐条件 ----
    let eq : logic = rd1 == rd2;
    let ltu: logic = rd1 <: rd2;
    let lts: logic = if rd1[31] != rd2[31] ? rd1[31] : ltu;

    let take_branch: logic = case dec.branch_op {
        RvPkg::BranchOp::beq : eq,
        RvPkg::BranchOp::bne : !eq,
        RvPkg::BranchOp::blt : lts,
        RvPkg::BranchOp::bge : !lts,
        RvPkg::BranchOp::bltu: ltu,
        RvPkg::BranchOp::bgeu: !ltu,
        default              : 1'b0,
    };

    let pc4: logic<32> = pc + 4;

    // JALR は分岐先の最下位ビットを 0 にする（RV32I 仕様）
    let jump_target  : logic<32> = if dec.jalr ? {alu_y[31:1], 1'b0} : alu_y;
    let branch_target: logic<32> = alu_y;

    let next_pc: logic<32> = if dec.jump ? jump_target : if dec.branch && take_branch ? branch_target : pc4;

    // ---- ロード / ストアのバイト整列 ----
    let byte_sel: logic<2> = alu_y[1:0];

    // ストア: rd2 を対象バイトレーンへ複製し，wstrb で選ぶ
    let store_wdata: logic<32> = case dec.mem_op {
        RvPkg::MemOp::b: {rd2[7:0] repeat 4},
        RvPkg::MemOp::h: {rd2[15:0] repeat 2},
        default        : rd2,
    };

    let store_wstrb: logic<4> = case dec.mem_op {
        RvPkg::MemOp::b: 4'b0001 << byte_sel,
        RvPkg::MemOp::h: if byte_sel[1] ? 4'b1100 : 4'b0011,
        default        : 4'b1111,
    };

    // ロード: メモリ語から対象バイト / 半語を切り出して拡張する
    var ld_addr_sel: logic       <2>; // memacc 中に保持したアドレス下位
    var ld_op      : RvPkg::MemOp   ;

    let ld_byte: logic<8>  = i_mem_rdata[8 * ld_addr_sel+:8];
    let ld_half: logic<16> = if ld_addr_sel[1] ? i_mem_rdata[31:16] : i_mem_rdata[15:0];

    let load_data: logic<32> = case ld_op {
        RvPkg::MemOp::b : {ld_byte[7] repeat 24, ld_byte},
        RvPkg::MemOp::h : {ld_half[15] repeat 16, ld_half},
        RvPkg::MemOp::bu: {1'b0 repeat 24, ld_byte},
        RvPkg::MemOp::hu: {1'b0 repeat 16, ld_half},
        default         : i_mem_rdata,
    };

    // ---- CSR とトラップ ----
    let in_exec: logic = state == State::exec;

    var csr_rdata  : logic<32>;
    var csr_illegal: logic    ;
    var csr_tvec   : logic<32>;
    var csr_epc    : logic<32>;
    var irq_pending: logic    ;

    let csr_valid: logic     = in_exec && dec.sys_op == RvPkg::SysOp::csr;
    let csr_wdata: logic<32> = if dec.csr_imm ? {27'b0, dec.rs1} : rd1;
    // CSRRW は常に書く．CSRRS/CSRRC は rs1 (または uimm) が 0 なら書かない
    let csr_wen: logic = dec.csr_op == 2'b01 || dec.rs1 != 0;

    // ロード / ストアのアドレス整列 (LW/SW は 4，LH/LHU/SH は 2 バイト境界)
    let addr_mis: logic = case dec.mem_op {
        RvPkg::MemOp::w                  : alu_y[1:0] != 2'b00,
        RvPkg::MemOp::h, RvPkg::MemOp::hu: alu_y[0] != 1'b0,
        default                          : 1'b0,
    };

    // 命令アドレス非整列は「分岐 / ジャンプ命令」で検出する．
    // 仕様上 mepc は分岐命令自身を指し，mtval は非整列な分岐先になるため，
    // フェッチ時ではなく実行時に判定する (riscv-tests rv32mi/ma_fetch)
    let trap_ifetch : logic = in_exec && (dec.jump || (dec.branch && take_branch)) && next_pc[1:0] != 2'b00;
    let trap_irq    : logic = state == State::fetch && !o_mem_valid && irq_pending;
    let trap_illegal: logic = in_exec && (dec.illegal || csr_illegal);
    let trap_ecall  : logic = in_exec && dec.sys_op == RvPkg::SysOp::ecall;
    let trap_ebreak : logic = in_exec && dec.sys_op == RvPkg::SysOp::ebreak;
    let trap_load   : logic = in_exec && dec.mem_read && addr_mis;
    let trap_store  : logic = in_exec && dec.mem_write && addr_mis;

    let trap_now: logic = trap_ifetch || trap_irq || trap_illegal || trap_ecall || trap_ebreak || trap_load
        || trap_store;

    // 原因コード (RISC-V 仕様 Machine cause register)．割り込みを最優先とする
    let trap_cause: logic<32> = if trap_irq ?
        32'h8000_0007
    : if trap_ifetch ?
        32'd0
    : if trap_illegal ?
        32'd2
    : if trap_ebreak ?
        32'd3
    : if trap_load ?
        32'd4
    : if trap_store ?
        32'd6
    :
        32'd11
    ;

    let trap_tval: logic<32> = if trap_ifetch ?
        next_pc
    : if trap_illegal ?
        iw
    : if trap_load || trap_store ?
        alu_y
    :
        32'b0
    ;

    let is_mret: logic = in_exec && dec.sys_op == RvPkg::SysOp::mret;

    inst csr: RvCsr (
        i_clk                      ,
        i_rst                      ,
        i_valid      : csr_valid   ,
        i_addr       : dec.csr_addr,
        i_op         : dec.csr_op  ,
        i_wdata      : csr_wdata   ,
        i_wen        : csr_wen     ,
        o_rdata      : csr_rdata   ,
        o_illegal    : csr_illegal ,
        i_trap       : trap_now    ,
        i_trap_cause : trap_cause  ,
        i_trap_pc    : pc          ,
        i_trap_tval  : trap_tval   ,
        i_mret       : is_mret     ,
        o_tvec       : csr_tvec    ,
        o_epc        : csr_epc     ,
        i_timer_irq  : i_timer_irq ,
        o_irq_pending: irq_pending ,
    );

    assign o_trap  = trap_now;
    assign o_cause = trap_cause;

    // ---- 乗除算 (M 拡張) ----
    var md_start : logic    ;
    var md_done  : logic    ;
    var md_result: logic<32>;

    inst muldiv: RvMulDiv (
        i_clk              ,
        i_rst              ,
        i_start : md_start ,
        i_funct3: dec.md_op,
        i_a     : rd1      ,
        i_b     : rd2      ,
        o_result: md_result,
        o_done  : md_done  ,
    );

    // 書き戻し値（ALU / メモリ / リンクアドレス）
    let wb_value: logic<32> = case dec.wb_sel {
        RvPkg::WbSel::mem: load_data,
        RvPkg::WbSel::pc4: pc4,
        RvPkg::WbSel::csr: csr_rdata,
        default          : alu_y,
    };

    assign o_pc = pc;

    always_ff (i_clk, i_rst) {
        if_reset {
            state       = State::fetch;
            pc          = ResetPc;
            iw          = 0;
            rf_we       = 0;
            rf_wdata    = 0;
            ld_addr_sel = 0;
            ld_op       = RvPkg::MemOp::w;
            md_start    = 0;
            o_mem_valid = 0;
            o_mem_addr  = 0;
            o_mem_write = 0;
            o_mem_wdata = 0;
            o_mem_wstrb = 0;
            o_illegal   = 0;
        } else {
            rf_we    = 0;
            md_start = 0;

            if trap_now {
                // トラップ: mepc / mcause / mtval の退避は RvCsr 側で行う．
                // ここでは実行を打ち切って mtvec へ飛ぶ
                if trap_illegal {
                    o_illegal = 1;
                }
                o_mem_valid = 0;
                o_mem_write = 0;
                o_mem_wstrb = 0;
                pc          = csr_tvec;
                state       = State::fetch;
            } else if state == State::fetch {
                o_mem_valid = 1;
                o_mem_addr  = pc;
                o_mem_write = 0;
                o_mem_wstrb = 0;
                if i_mem_done {
                    o_mem_valid = 0;
                    iw          = i_mem_rdata;
                    state       = State::rdreg;
                }
            } else if state == State::rdreg {
                // デコード結果の rs1 / rs2 は前サイクルから確定しているため，
                // ここで 1 サイクル待てばレジスタ値が揃う
                state = State::exec;
            } else if state == State::exec {
                if is_mret {
                    // MRET: mstatus の復帰は RvCsr 側で行う
                    pc    = csr_epc;
                    state = State::fetch;
                } else if dec.muldiv {
                    md_start = 1;
                    state    = State::mdwait;
                } else if dec.mem_read || dec.mem_write {
                    o_mem_valid = 1;
                    o_mem_addr  = alu_y;
                    o_mem_write = dec.mem_write;
                    o_mem_wdata = store_wdata;
                    o_mem_wstrb = if dec.mem_write ? store_wstrb : 4'b0000;
                    ld_addr_sel = byte_sel;
                    ld_op       = dec.mem_op;
                    state       = State::memacc;
                } else {
                    rf_we    = dec.reg_write;
                    rf_wdata = wb_value;
                    pc       = next_pc;
                    state    = State::fetch;
                }
            } else if state == State::mdwait {
                if md_done {
                    rf_we    = dec.reg_write;
                    rf_wdata = md_result;
                    pc       = pc4;
                    state    = State::fetch;
                }
            } else if state == State::memacc {
                if i_mem_done {
                    o_mem_valid = 0;
                    o_mem_write = 0;
                    o_mem_wstrb = 0;
                    rf_we       = dec.reg_write; // ロードのみ 1（ストアは 0）
                    rf_wdata    = wb_value;
                    pc          = pc4;
                    state       = State::fetch;
                }
            }
        }
    }
}
