/// TF カードサブシステムの共有型定義 (docs/tfcard.md「インタフェース」)
pub package TfTypes {
    /// ブロックリード / 初期化のエラー種別
    enum Error: logic<3> {
        /// エラーなし
        none,
        /// 初期化未完了
        not_init,
        /// 応答・トークン・初期化のタイムアウト
        timeout,
        /// データ CRC16 不一致 (データはストリーム済，リトライは利用側判断)
        crc,
        /// 非対応カード (CMD8 不応答 = 旧世代 / CCS=0 = バイトアドレッシング)
        unsupported,
        /// 予期しない応答 (R1 エラービット / エラートークン)
        resp,
    }

    /// FAT32 リーダのエラー種別
    enum FsError: logic<2> {
        /// エラーなし
        none,
        /// ファイルシステム不正 (MBR/BPB 検証失敗，FAT32 でない)
        no_fs,
        /// 8.3 名が一致するエントリなし
        not_found,
        /// 下位ブロックリードのエラー (種別は TfCtrl 側で報告)
        io,
    }
}
