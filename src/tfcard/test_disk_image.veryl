            9'd68  : 8'hff,
            9'd70  : 8'hff,
            9'd72  : 8'hff,
            9'd75  : 8'hff,
            9'd76  : 8'hff,
            9'd77  : 8'hff,
            default: 8'h00,
        };
    }
    function SfByte (
        lba: input logic<32>,
        off: input logic<9> ,
    ) -> logic<8> {
        return case lba {
            32'd0  : SfByteS0000(off),
            32'd4  : SfByteS0004(off),
            32'd6  : SfByteS0006(off),
            32'd8  : SfByteS0008(off),
            32'd10 : SfByteS000a(off),
            32'd11 : SfByteS000b(off),
            32'd12 : SfByteS000c(off),
            32'd14 : SfByteS000e(off),
            32'd15 : SfByteS000f(off),
            32'd18 : SfByteS0012(off),
            32'd20 : SfByteS0014(off),
            32'd24 : SfByteS0018(off),
            default: 8'h00,
        };
    }
}
