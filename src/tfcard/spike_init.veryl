/// TF カード初期化 spike (docs/tfcard.md「spike の構成」)
///
/// SpiMaster + 最小シーケンサで初期化シーケンス (CMD0 → CMD8 → CMD55/ACMD41
/// ポーリング → CMD58) を完走し，データクロックへ切り替えて CMD17 で
/// セクタ 0 (MBR) を読む．結果は ASCII 1 行の stream として送出する:
///
/// ```text
/// TF R1=xx,xx,xx,xx OCR=xxxxxxxx S0=<先頭16バイトhex> SIG=K E=-
/// ```
///
/// - `R1=` は CMD0 / CMD8 / ACMD41 (最終) / CMD58 の R1 (未実行は FF)
/// - `SIG=` は MBR 署名 55AAh の検査 (K=一致 / N=不一致)
/// - `E=` はエラー段 (`-` なし / `0` CMD0 / `8` CMD8 非対応 /
///   `A` ACMD41 タイムアウト / `C` CCS=0 非対応 / `R` CMD17 応答・トークン異常 /
///   `X` データ CRC16 不一致)
///
/// 発行コマンドは CMD0/CMD8/CMD55/ACMD41/CMD58/CMD17 のみ (リード専用，
/// write 系は FSM 上存在しない)．
pub module TfSpikeInit #(
    /// 初期化クロック分周比 (337.5 kHz)
    param InitDivider: u32 = 80,
    /// データ転送クロック分周比 (13.5 MHz)
    param FastDivider: u32 = 2,
    /// 電源投入クロック供給のバイト数 (74 クロック以上 → 10 バイト = 80 クロック)
    param PowerUpBytes: u32 = 10,
    /// R1 応答待ちの上限バイト数 (NCR)
    param NcrMaxBytes: u32 = 8,
    /// ACMD41 ポーリング上限回数 (337.5 kHz で約 1.2 s 相当)
    param Acmd41MaxPolls: u32 = 3000,
    /// データトークン待ちの上限バイト数 (13.5 MHz で約 155 ms 相当)
    param TokenMaxBytes: u32 = 262144,
) (
    i_clk: input clock, /// クロック (27 MHz)
    i_rst: input reset, /// リセット

    o_sclk: output logic, /// TF SCK
    o_mosi: output logic, /// TF MOSI
    o_cs_n: output logic, /// TF CS#
    i_miso: input  logic, /// TF MISO

    msg: modport stream_if::source, /// 結果メッセージ (リセット毎に 1 行送出)
) {
    const MsgLen: u32 = 78;

    enum State: logic<4> {
        power_up,
        cmd_send,
        r1_wait,
        r7_read,
        token_wait,
        data_read,
        crc_read,
        trailer,
        send_msg,
        done,
    }

    // コマンド列 (cstep): 0=CMD0, 1=CMD8, 2=CMD55, 3=ACMD41, 4=CMD58, 5=CMD17
    function CmdCode (
        stp: input logic<3>,
    ) -> logic<6> {
        return case stp {
            0      : 6'd0,
            1      : 6'd8,
            2      : 6'd55,
            3      : 6'd41,
            4      : 6'd58,
            default: 6'd17,
        };
    }

    function CmdArg (
        stp: input logic<3>,
    ) -> logic<32> {
        return case stp {
            1      : 32'h0000_01aa, // CMD8: 電圧範囲 + チェックパターン
            3      : 32'h4000_0000, // ACMD41: HCS=1
            default: 32'h0000_0000, // CMD17 は LBA=0 (MBR)
        };
    }

    // コマンドフレームの 2 バイト目以降 (idx は直前に送ったバイトの位置)
    function CmdTxByte (
        stp: input logic<3>,
        idx: input logic<3>,
        crc: input logic<7>,
    ) -> logic<8> {
        var a: logic<32>;
        a = CmdArg(stp);
        return case idx {
            0      : a[31:24],
            1      : a[23:16],
            2      : a[15:8],
            3      : a[7:0],
            default: {crc, 1'b1},
        };
    }

    // 応答タイムアウト時のエラー段
    function StepErr (
        stp: input logic<3>,
    ) -> logic<8> {
        return case stp {
            0      : 8'h30, // '0'
            1      : 8'h38, // '8'
            2      : 8'h41, // 'A'
            3      : 8'h41, // 'A'
            4      : 8'h43, // 'C'
            default: 8'h52, // 'R'
        };
    }

    function HexChar (
        n: input logic<4>,
    ) -> logic<8> {
        return if n <: 4'd10 ? 8'h30 + {4'b0000, n} : 8'h37 + {4'b0000, n};
    }

    const PollCntWidth : u32 = $clog2(Acmd41MaxPolls);
    const TokenCntWidth: u32 = $clog2(TokenMaxBytes);

    var state        : State                    ;
    var cstep        : logic<3>                 ;
    var after_trailer: logic<3>                 ; // 次に開始する cstep (7 = 報告へ)
    var pcnt         : logic<4>                 ;
    var byte_idx     : logic<3>                 ;
    var crc7         : logic<7>                 ;
    var ncr_cnt      : logic<4>                 ;
    var poll_cnt     : logic<PollCntWidth>      ;
    var token_cnt    : logic<TokenCntWidth>     ;
    var r1_0         : logic<8>                 ;
    var r1_8         : logic<8>                 ;
    var r1_41        : logic<8>                 ;
    var r1_58        : logic<8>                 ;
    var r7_buf       : logic<32>                ;
    var r7_cnt       : logic<2>                 ;
    var ocr          : logic<32>                ;
    var head         : logic<8>             [16];
    var sig_hi       : logic<8>                 ;
    var sig_lo       : logic<8>                 ;
    var data_cnt     : logic<10>                ;
    var crc16        : logic<16>                ;
    var crc_hi_rx    : logic<8>                 ;
    var crc_cnt      : logic                    ;
    var err_code     : logic<8>                 ;
    var send_idx     : logic<7>                 ;

    // SPI マスタ
    var spi_fast: logic   ;
    var spi_vld : logic   ;
    var spi_dat : logic<8>;
    var spi_rdy : logic   ;
    var spi_ovld: logic   ;
    var spi_odat: logic<8>;

    inst spi: SpiMaster #(
        InitDivider: InitDivider,
        FastDivider: FastDivider,
    ) (
        i_clk            ,
        i_rst            ,
        i_fast : spi_fast,
        i_valid: spi_vld ,
        i_data : spi_dat ,
        o_ready: spi_rdy ,
        o_valid: spi_ovld,
        o_data : spi_odat,
        o_sclk           ,
        o_mosi           ,
        i_miso           ,
    );

    // "TF R1=xx,xx,xx,xx OCR=xxxxxxxx S0=<32hex> SIG=x E=x\r\n" (78 byte)
    assign msg.data = case send_idx {
        0      : 8'h54, // 'T'
        1      : 8'h46, // 'F'
        2      : 8'h20, // ' '
        3      : 8'h52, // 'R'
        4      : 8'h31, // '1'
        5      : 8'h3d, // '='
        6      : HexChar(r1_0[7:4]),
        7      : HexChar(r1_0[3:0]),
        8      : 8'h2c, // ','
        9      : HexChar(r1_8[7:4]),
        10     : HexChar(r1_8[3:0]),
        11     : 8'h2c, // ','
        12     : HexChar(r1_41[7:4]),
        13     : HexChar(r1_41[3:0]),
        14     : 8'h2c, // ','
        15     : HexChar(r1_58[7:4]),
        16     : HexChar(r1_58[3:0]),
        17     : 8'h20, // ' '
        18     : 8'h4f, // 'O'
        19     : 8'h43, // 'C'
        20     : 8'h52, // 'R'
        21     : 8'h3d, // '='
        22     : HexChar(ocr[31:28]),
        23     : HexChar(ocr[27:24]),
        24     : HexChar(ocr[23:20]),
        25     : HexChar(ocr[19:16]),
        26     : HexChar(ocr[15:12]),
        27     : HexChar(ocr[11:8]),
        28     : HexChar(ocr[7:4]),
        29     : HexChar(ocr[3:0]),
        30     : 8'h20, // ' '
        31     : 8'h53, // 'S'
        32     : 8'h30, // '0'
        33     : 8'h3d, // '='
        34     : HexChar(head[0][7:4]),
        35     : HexChar(head[0][3:0]),
        36     : HexChar(head[1][7:4]),
        37     : HexChar(head[1][3:0]),
        38     : HexChar(head[2][7:4]),
        39     : HexChar(head[2][3:0]),
        40     : HexChar(head[3][7:4]),
        41     : HexChar(head[3][3:0]),
        42     : HexChar(head[4][7:4]),
        43     : HexChar(head[4][3:0]),
        44     : HexChar(head[5][7:4]),
        45     : HexChar(head[5][3:0]),
        46     : HexChar(head[6][7:4]),
        47     : HexChar(head[6][3:0]),
        48     : HexChar(head[7][7:4]),
        49     : HexChar(head[7][3:0]),
        50     : HexChar(head[8][7:4]),
        51     : HexChar(head[8][3:0]),
        52     : HexChar(head[9][7:4]),
        53     : HexChar(head[9][3:0]),
        54     : HexChar(head[10][7:4]),
        55     : HexChar(head[10][3:0]),
        56     : HexChar(head[11][7:4]),
        57     : HexChar(head[11][3:0]),
        58     : HexChar(head[12][7:4]),
        59     : HexChar(head[12][3:0]),
        60     : HexChar(head[13][7:4]),
        61     : HexChar(head[13][3:0]),
        62     : HexChar(head[14][7:4]),
        63     : HexChar(head[14][3:0]),
        64     : HexChar(head[15][7:4]),
        65     : HexChar(head[15][3:0]),
        66     : 8'h20, // ' '
        67     : 8'h53, // 'S'
        68     : 8'h49, // 'I'
        69     : 8'h47, // 'G'
        70     : 8'h3d, // '='
        71     : if sig_hi == 8'h55 && sig_lo == 8'haa ? 8'h4b : 8'h4e, // 'K'/'N'
        72     : 8'h20, // ' '
        73     : 8'h45, // 'E'
        74     : 8'h3d, // '='
        75     : err_code,
        76     : 8'h0d, // CR
        77     : 8'h0a, // LF
        default: 8'h00,
    };

    always_ff (i_clk, i_rst) {
        if_reset {
            state         = State::power_up;
            cstep         = 0;
            after_trailer = 0;
            pcnt          = 0;
            byte_idx      = 0;
            crc7          = 0;
            ncr_cnt       = 0;
            poll_cnt      = 0;
            token_cnt     = 0;
            r1_0          = '1;
            r1_8          = '1;
            r1_41         = '1;
            r1_58         = '1;
            r7_buf        = 0;
            r7_cnt        = 0;
            ocr           = 0;
            head[0]       = 0;
            head[1]       = 0;
            head[2]       = 0;
            head[3]       = 0;
            head[4]       = 0;
            head[5]       = 0;
            head[6]       = 0;
            head[7]       = 0;
            head[8]       = 0;
            head[9]       = 0;
            head[10]      = 0;
            head[11]      = 0;
            head[12]      = 0;
            head[13]      = 0;
            head[14]      = 0;
            head[15]      = 0;
            sig_hi        = 0;
            sig_lo        = 0;
            data_cnt      = 0;
            crc16         = 0;
            crc_hi_rx     = 0;
            crc_cnt       = 0;
            err_code      = 8'h2d; // '-'
            send_idx      = 0;
            spi_fast      = 0;
            spi_vld       = 1; // 電源投入クロック供給の先頭バイトを即発行
            spi_dat       = '1;
            o_cs_n        = 1;
            msg.valid     = 0;
        } else {
            // SPI 送信バイトの handshake 成立で valid を落とす
            // (以降の受信完了時の再発行が優先される)
            if spi_vld && spi_rdy {
                spi_vld = 0;
            }

            if state == State::power_up {
                if spi_ovld {
                    if pcnt == PowerUpBytes - 1 {
                        // CMD0 開始
                        o_cs_n   = 0;
                        state    = State::cmd_send;
                        cstep    = 0;
                        byte_idx = 0;
                        spi_dat  = {2'b01, CmdCode(3'd0)};
                        crc7     = TfCrc::Crc7Byte(7'd0, {2'b01, CmdCode(3'd0)});
                        spi_vld  = 1;
                    } else {
                        pcnt    = pcnt + 1;
                        spi_dat = '1;
                        spi_vld = 1;
                    }
                }
            } else if state == State::cmd_send {
                if spi_ovld {
                    if byte_idx == 3'd5 {
                        state   = State::r1_wait;
                        ncr_cnt = 0;
                        spi_dat = '1;
                        spi_vld = 1;
                    } else {
                        spi_dat = CmdTxByte(cstep, byte_idx, crc7);
                        if byte_idx <: 3'd4 {
                            crc7 = TfCrc::Crc7Byte(crc7, CmdTxByte(cstep, byte_idx, crc7));
                        }
                        byte_idx = byte_idx + 1;
                        spi_vld  = 1;
                    }
                }
            } else if state == State::r1_wait {
                if spi_ovld {
                    if spi_odat[7] == 1'b0 {
                        // R1 受信
                        if cstep == 3'd0 {
                            r1_0 = spi_odat;
                            if spi_odat == 8'h01 {
                                state         = State::trailer;
                                after_trailer = 1;
                            } else {
                                err_code      = 8'h30; // '0'
                                state         = State::trailer;
                                after_trailer = 7;
                            }
                            o_cs_n  = 1;
                            spi_dat = '1;
                            spi_vld = 1;
                        } else if cstep == 3'd1 {
                            r1_8 = spi_odat;
                            if (spi_odat & 8'hfe) == 8'h00 {
                                // R7 残り 4 バイトへ
                                state   = State::r7_read;
                                r7_cnt  = 0;
                                spi_dat = '1;
                                spi_vld = 1;
                            } else {
                                // illegal command 等: 旧世代カード
                                err_code      = 8'h38; // '8'
                                state         = State::trailer;
                                after_trailer = 7;
                                o_cs_n        = 1;
                                spi_dat       = '1;
                                spi_vld       = 1;
                            }
                        } else if cstep == 3'd2 {
                            if (spi_odat & 8'hfe) == 8'h00 {
                                state         = State::trailer;
                                after_trailer = 3;
                            } else {
                                err_code      = 8'h41; // 'A'
                                state         = State::trailer;
                                after_trailer = 7;
                            }
                            o_cs_n  = 1;
                            spi_dat = '1;
                            spi_vld = 1;
                        } else if cstep == 3'd3 {
                            r1_41 = spi_odat;
                            if spi_odat == 8'h00 {
                                state         = State::trailer;
                                after_trailer = 4;
                            } else if spi_odat == 8'h01 && poll_cnt <: Acmd41MaxPolls - 1 {
                                poll_cnt      = poll_cnt + 1;
                                state         = State::trailer;
                                after_trailer = 2;
                            } else {
                                err_code      = 8'h41; // 'A'
                                state         = State::trailer;
                                after_trailer = 7;
                            }
                            o_cs_n  = 1;
                            spi_dat = '1;
                            spi_vld = 1;
                        } else if cstep == 3'd4 {
                            r1_58 = spi_odat;
                            if spi_odat == 8'h00 {
                                state   = State::r7_read;
                                r7_cnt  = 0;
                                spi_dat = '1;
                                spi_vld = 1;
                            } else {
                                err_code      = 8'h43; // 'C'
                                state         = State::trailer;
                                after_trailer = 7;
                                o_cs_n        = 1;
                                spi_dat       = '1;
                                spi_vld       = 1;
                            }
                        } else {
                            // CMD17
                            if spi_odat == 8'h00 {
                                state     = State::token_wait;
                                token_cnt = 0;
                                spi_dat   = '1;
                                spi_vld   = 1;
                            } else {
                                err_code      = 8'h52; // 'R'
                                state         = State::trailer;
                                after_trailer = 7;
                                o_cs_n        = 1;
                                spi_dat       = '1;
                                spi_vld       = 1;
                            }
                        }
                    } else if ncr_cnt == NcrMaxBytes - 1 {
                        // 応答タイムアウト
                        err_code      = StepErr(cstep);
                        state         = State::trailer;
                        after_trailer = 7;
                        o_cs_n        = 1;
                        spi_dat       = '1;
                        spi_vld       = 1;
                    } else {
                        ncr_cnt = ncr_cnt + 1;
                        spi_dat = '1;
                        spi_vld = 1;
                    }
                }
            } else if state == State::r7_read {
                if spi_ovld {
                    r7_buf = {r7_buf[23:0], spi_odat};
                    if r7_cnt == 2'd3 {
                        o_cs_n  = 1;
                        spi_dat = '1;
                        spi_vld = 1;
                        state   = State::trailer;
                        if cstep == 3'd1 {
                            // CMD8: 電圧範囲 + チェックパターンの echo 確認
                            if r7_buf[3:0] == 4'h1 && spi_odat == 8'haa {
                                after_trailer = 2;
                            } else {
                                err_code      = 8'h38; // '8'
                                after_trailer = 7;
                            }
                        } else {
                            // CMD58: OCR 確定と CCS 検査
                            ocr = {r7_buf[23:0], spi_odat};
                            if r7_buf[22] == 1'b1 {
                                // CCS=1: データクロックへ切替して CMD17 へ
                                spi_fast      = 1;
                                after_trailer = 5;
                            } else {
                                err_code      = 8'h43; // 'C'
                                after_trailer = 7;
                            }
                        }
                    } else {
                        r7_cnt  = r7_cnt + 1;
                        spi_dat = '1;
                        spi_vld = 1;
                    }
                }
            } else if state == State::token_wait {
                if spi_ovld {
                    if spi_odat == 8'hfe {
                        state    = State::data_read;
                        data_cnt = 0;
                        crc16    = 0;
                        spi_dat  = '1;
                        spi_vld  = 1;
                    } else if spi_odat == 8'hff && token_cnt <: TokenMaxBytes - 1 {
                        token_cnt = token_cnt + 1;
                        spi_dat   = '1;
                        spi_vld   = 1;
                    } else {
                        // エラートークンまたはタイムアウト
                        err_code      = 8'h52; // 'R'
                        state         = State::trailer;
                        after_trailer = 7;
                        o_cs_n        = 1;
                        spi_dat       = '1;
                        spi_vld       = 1;
                    }
                }
            } else if state == State::data_read {
                if spi_ovld {
                    if data_cnt <: 10'd16 {
                        head[data_cnt[3:0]] = spi_odat;
                    }
                    if data_cnt == 10'd510 {
                        sig_hi = spi_odat;
                    }
                    if data_cnt == 10'd511 {
                        sig_lo  = spi_odat;
                        state   = State::crc_read;
                        crc_cnt = 0;
                    }
                    crc16    = TfCrc::Crc16Byte(crc16, spi_odat);
                    data_cnt = data_cnt + 1;
                    spi_dat  = '1;
                    spi_vld  = 1;
                }
            } else if state == State::crc_read {
                if spi_ovld {
                    if crc_cnt == 1'b0 {
                        crc_hi_rx = spi_odat;
                        crc_cnt   = 1;
                        spi_dat   = '1;
                        spi_vld   = 1;
                    } else {
                        if {crc_hi_rx, spi_odat} != crc16 {
                            err_code = 8'h58; // 'X'
                        }
                        state         = State::trailer;
                        after_trailer = 7;
                        o_cs_n        = 1;
                        spi_dat       = '1;
                        spi_vld       = 1;
                    }
                }
            } else if state == State::trailer {
                if spi_ovld {
                    if after_trailer == 3'd7 {
                        state     = State::send_msg;
                        send_idx  = 0;
                        msg.valid = 1;
                    } else {
                        o_cs_n   = 0;
                        state    = State::cmd_send;
                        cstep    = after_trailer;
                        byte_idx = 0;
                        spi_dat  = {2'b01, CmdCode(after_trailer)};
                        crc7     = TfCrc::Crc7Byte(7'd0, {2'b01, CmdCode(after_trailer)});
                        spi_vld  = 1;
                    }
                }
            } else if state == State::send_msg {
                if msg.valid && msg.ready {
                    if send_idx == MsgLen - 1 {
                        msg.valid = 0;
                        state     = State::done;
                    } else {
                        send_idx = send_idx + 1;
                    }
                }
            }
            // State::done: リセットまで何もしない
        }
    }
}
