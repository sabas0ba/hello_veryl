// TF カード SPI モードのビヘイビアモデル (L1 検証用，docs/tfcard.md
// 「L1: 自作ビヘイビアモデルとテスト」)．Simplified Specification の
// 自前解釈のみから実装しており，外部コードの引用はない．
// DUT と共通の解釈を共有する共通モード誤りは L4 (実機 spike) で照合する．
//
// - システムクロック同期で SCK エッジを検出する (ノンブロッキング代入の
//   意味論により，SCK 半周期 = 1 サイクル (13.5 MHz) でもマスタが駆動した
//   安定値を観測できる)
// - バイト境界は CS# assert からのビット数で追跡する (マスタは常に
//   8 bit 単位で駆動する前提)
// - 受信処理・送信シフトとも SCK 立上り検出後に行う．実カードは立下りで
//   出力を遷移させるが，マスタのサンプルは立上りのため「サンプル直後の
//   遷移」で等価になり，かつ半周期 = 1 サイクルでも次の立上りに間に合う
//   (立下り検出後の遷移では 1 サイクル遅れて次の立上りサンプルを取り逃す)．
//   コマンド応答のスケジュール (受信側) と送信バイト選択が同一エッジに
//   重なるバイト境界では，ノンブロッキング代入の意味論により送信側は
//   旧状態を参照する．このため応答は NcrBytes + 1 バイト目に現れる
//   (仕様の NCR 0〜8 バイトの範囲内)
// - 背後ストレージは o_img_lba / o_img_off → i_img_data の組合せ参照で
//   テストベンチから注入する (リード)
// - ライト (CMD24) は受け取ったバイトを o_wr_* で外へ出すだけで，
//   モデル内には保持しない (テストベンチ側で捕まえて検証する)
module TfCardModel #(
    /// コマンド終端から R1 までの 0xFF バイト数 (NCR)
    param NcrBytes: u32 = 1,
    /// ACMD41 が ready (idle 解除) を返すまでの要求回数
    param Acmd41Polls: u32 = 2,
    /// CMD17 R1 からデータトークンまでの 0xFF バイト数
    param DataWaitBytes: u32 = 2,
    /// CMD24 のデータ応答後にビジー (0x00) を返すバイト数
    param BusyBytes: u32 = 2,
) (
    i_clk: input clock, /// システムクロック (DUT と共通)
    i_rst: input reset, /// リセット

    i_sclk: input  logic, /// SPI SCK
    i_cs_n: input  logic, /// SPI CS#
    i_mosi: input  logic, /// SPI MOSI
    o_miso: output logic, /// SPI MISO

    // エラー注入 (テストシナリオ設定)
    i_cfg_legacy_cmd8: input logic, /// 1: CMD8 に illegal command (旧世代カード)
    i_cfg_ccs        : input logic, /// OCR の CCS ビット値 (0 で旧世代扱い)
    i_cfg_never_ready: input logic, /// 1: ACMD41 が idle のまま (初期化タイムアウト)
    i_cfg_no_token   : input logic, /// 1: CMD17 のデータトークンを送らない
    i_cfg_corrupt_crc: input logic, /// 1: データ CRC16 の上位バイトを破壊
    i_cfg_wr_err     : input logic, /// 1: CMD24 のデータ応答を write error にする

    // 背後ストレージ (組合せ参照)
    o_img_lba : output logic<32>, /// 読み出し中ブロックの LBA
    o_img_off : output logic<9> , /// ブロック内オフセット
    i_img_data: input  logic<8> , /// 該当バイトの値

    // 書き込み観測 (CMD24)．o_wr_en の 1 サイクルパルスで 1 バイト有効
    o_wr_en  : output logic    , /// 書き込みバイト有効
    o_wr_lba : output logic<32>, /// 書き込み中ブロックの LBA
    o_wr_off : output logic<9> , /// ブロック内オフセット
    o_wr_data: output logic<8> , /// 受け取ったバイト
) {
    // 応答フェーズ (送信バイト境界で遷移)
    enum Resp: logic<4> {
        none,
        ncr,
        payload,
        data_wait,
        data,
        crc_hi,
        crc_lo,
        wr_pre, // CMD24: ホストからのデータを受けている間 (0xFF を返す)
        wr_resp, // データ応答トークン
        wr_busy, // 書き込み中 (0x00 を返す)
    }
    // R1 の後に続くもの
    enum AfterR1: logic<2> {
        none,
        payload,
        data_wait,
        wr,
    }
    // CMD24 のデータ受信フェーズ
    enum WrPhase: logic<2> {
        token,
        data,
        crc_hi,
        crc_lo,
    }

    var sclk_q: logic;

    // 受信側 (立上りでシフト)
    var rx_sh   : logic<8> ;
    var rx_cnt  : logic<3> ;
    var cap_idx : logic<3> ; // コマンドフレーム内バイト位置 (0..5)
    var cmd     : logic<6> ;
    var arg     : logic<32>;
    var crc7_acc: logic<7> ;

    // カード状態
    var in_idle: logic    ;
    var ready  : logic    ; // ACMD41 完了 (初期化済)
    var app_cmd: logic    ;
    var polls  : logic<16>;

    // 送信側 (立上り検出後にシフト/ロード)
    var tx_sh   : logic  <8> ;
    var resp    : Resp       ;
    var after_r1: AfterR1    ;
    var r1_val  : logic  <8> ;
    var ncr_cnt : logic  <8> ;
    var pay     : logic  <32>;
    var pay_cnt : logic  <2> ;
    var wait_cnt: logic  <8> ;
    var crc16   : logic  <16>;
    var busy_cnt: logic  <8> ;

    // CMD24 (ライト)
    var wr_active: logic      ;
    var wr_phase : WrPhase    ;
    var wr_crc   : logic  <16>;
    var wr_crc_hi: logic  <8> ;
    var wr_crc_ok: logic      ;
    var wr_idx   : logic  <9> ; // 次に受け取るバイトの位置

    let rise: logic = !i_cs_n && i_sclk && !sclk_q;

    assign o_miso = tx_sh[7];

    always_ff (i_clk, i_rst) {
        if_reset {
            sclk_q    = 0;
            rx_sh     = 0;
            rx_cnt    = 0;
            cap_idx   = 0;
            cmd       = 0;
            arg       = 0;
            crc7_acc  = 0;
            in_idle   = 0;
            ready     = 0;
            app_cmd   = 0;
            polls     = 0;
            tx_sh     = '1;
            resp      = Resp::none;
            after_r1  = AfterR1::none;
            r1_val    = '1;
            ncr_cnt   = 0;
            pay       = 0;
            pay_cnt   = 0;
            wait_cnt  = 0;
            crc16     = 0;
            busy_cnt  = 0;
            wr_active = 0;
            wr_phase  = WrPhase::token;
            wr_crc    = 0;
            wr_crc_hi = 0;
            wr_crc_ok = 0;
            wr_idx    = 0;
            o_img_lba = 0;
            o_img_off = 0;
            o_wr_en   = 0;
            o_wr_lba  = 0;
            o_wr_off  = 0;
            o_wr_data = 0;
        } else {
            o_wr_en = 0;
            sclk_q  = i_sclk;

            if i_cs_n {
                // 非選択: ビット位相と進行中の応答を破棄 (カード状態は保持)
                rx_cnt    = 0;
                tx_sh     = '1;
                cap_idx   = 0;
                resp      = Resp::none;
                wr_active = 0;
            } else {
                // ---- 受信: SCK 立上りで MOSI をシフト，8 ビット目でバイト処理 ----
                if rise {
                    rx_sh = {rx_sh[6:0], i_mosi};
                    if rx_cnt == 3'd7 {
                        rx_cnt = 0;
                        // 完成バイト = {rx_sh[6:0], i_mosi}
                        if wr_active {
                            // CMD24: トークン -> 512 バイト -> CRC16
                            if wr_phase == WrPhase::token {
                                if {rx_sh[6:0], i_mosi} == 8'hfe {
                                    wr_phase = WrPhase::data;
                                    wr_idx   = 0;
                                    wr_crc   = 0;
                                }
                            } else if wr_phase == WrPhase::data {
                                // o_wr_off は o_wr_en と同じサイクルで有効にする．
                                // 内部カウンタ wr_idx とは別に「報告中のバイトの位置」を出す
                                o_wr_en   = 1;
                                o_wr_off  = wr_idx;
                                o_wr_data = {rx_sh[6:0], i_mosi};
                                wr_crc    = TfCrc::Crc16Byte(wr_crc, {rx_sh[6:0], i_mosi});
                                if wr_idx == 9'd511 {
                                    wr_phase = WrPhase::crc_hi;
                                } else {
                                    wr_idx = wr_idx + 1;
                                }
                            } else if wr_phase == WrPhase::crc_hi {
                                wr_crc_hi = {rx_sh[6:0], i_mosi};
                                wr_phase  = WrPhase::crc_lo;
                            } else {
                                wr_crc_ok = {wr_crc_hi, rx_sh[6:0], i_mosi} == wr_crc;
                                wr_active = 0;
                                resp      = Resp::wr_resp;
                            }
                        } else if cap_idx == 3'd0 {
                            // start bit (0) + transmission bit (1) でフレーム開始
                            if rx_sh[6:5] == 2'b01 {
                                cmd      = {rx_sh[4:0], i_mosi};
                                crc7_acc = TfCrc::Crc7Byte(7'd0, {rx_sh[6:0], i_mosi});
                                cap_idx  = 1;
                            }
                        } else if cap_idx <: 3'd5 {
                            arg      = {arg[23:0], rx_sh[6:0], i_mosi};
                            crc7_acc = TfCrc::Crc7Byte(crc7_acc, {rx_sh[6:0], i_mosi});
                            cap_idx  = cap_idx + 1;
                        } else {
                            // CRC バイト: コマンド実行と応答スケジュール
                            cap_idx = 0;
                            resp    = Resp::ncr;
                            ncr_cnt = NcrBytes;
                            if {rx_sh[6:0], i_mosi} != {crc7_acc, 1'b1} {
                                // CRC 不正 (DUT のバグ検出用): com CRC error
                                r1_val   = {6'b000010, 1'b0, in_idle};
                                after_r1 = AfterR1::none;
                            } else if cmd == 6'd0 {
                                // CMD0: idle 遷移
                                in_idle  = 1;
                                ready    = 0;
                                polls    = 0;
                                r1_val   = 8'h01;
                                after_r1 = AfterR1::none;
                            } else if cmd == 6'd8 {
                                if i_cfg_legacy_cmd8 {
                                    r1_val   = {5'b00000, 1'b1, 1'b0, in_idle}; // illegal
                                    after_r1 = AfterR1::none;
                                } else {
                                    r1_val   = {7'b0000000, in_idle};
                                    pay      = {16'h0000, 8'h01, arg[7:0]}; // 電圧 OK + echo
                                    after_r1 = AfterR1::payload;
                                }
                            } else if cmd == 6'd55 {
                                app_cmd  = 1;
                                r1_val   = {7'b0000000, in_idle};
                                after_r1 = AfterR1::none;
                            } else if cmd == 6'd41 && app_cmd {
                                if i_cfg_never_ready {
                                    r1_val = 8'h01;
                                } else if polls == Acmd41Polls - 1 {
                                    in_idle = 0;
                                    ready   = 1;
                                    r1_val  = 8'h00;
                                } else {
                                    polls  = polls + 1;
                                    r1_val = 8'h01;
                                }
                                after_r1 = AfterR1::none;
                            } else if cmd == 6'd58 {
                                r1_val   = {7'b0000000, in_idle};
                                pay      = {ready, i_cfg_ccs, 6'b000000, 8'hff, 8'h80, 8'h00};
                                after_r1 = AfterR1::payload;
                            } else if cmd == 6'd17 && ready && !in_idle {
                                r1_val    = 8'h00;
                                o_img_lba = arg;
                                wait_cnt  = DataWaitBytes;
                                after_r1  = AfterR1::data_wait;
                            } else if cmd == 6'd24 && ready && !in_idle {
                                r1_val    = 8'h00;
                                o_wr_lba  = arg;
                                wr_active = 1;
                                wr_phase  = WrPhase::token;
                                after_r1  = AfterR1::wr;
                            } else {
                                // 未対応/順序不正: illegal command
                                r1_val   = {5'b00000, 1'b1, 1'b0, in_idle};
                                after_r1 = AfterR1::none;
                            }
                            if cmd != 6'd55 {
                                app_cmd = 0;
                            }
                        }
                    } else {
                        rx_cnt = rx_cnt + 1;
                    }

                    // ---- 送信: サンプル済ビットを立上り検出後に更新，
                    //      バイト境界 (8 ビット目) で次バイトをロード ----
                    if rx_cnt == 3'd7 {
                        if resp == Resp::none {
                            tx_sh = '1;
                        } else if resp == Resp::ncr {
                            if ncr_cnt >: 0 {
                                tx_sh   = '1;
                                ncr_cnt = ncr_cnt - 1;
                            } else {
                                tx_sh   = r1_val;
                                pay_cnt = 0;
                                resp    = case after_r1 {
                                    AfterR1::payload  : Resp::payload,
                                    AfterR1::data_wait: Resp::data_wait,
                                    AfterR1::wr       : Resp::wr_pre,
                                    default           : Resp::none,
                                };
                            }
                        } else if resp == Resp::payload {
                            tx_sh = pay[31:24];
                            pay   = {pay[23:0], 8'h00};
                            if pay_cnt == 2'd3 {
                                resp = Resp::none;
                            } else {
                                pay_cnt = pay_cnt + 1;
                            }
                        } else if resp == Resp::data_wait {
                            if wait_cnt >: 0 {
                                tx_sh    = '1;
                                wait_cnt = wait_cnt - 1;
                            } else if i_cfg_no_token {
                                tx_sh = '1; // トークンを出さない (タイムアウト注入)
                            } else {
                                tx_sh     = 8'hfe;
                                o_img_off = 0;
                                crc16     = 0;
                                resp      = Resp::data;
                            }
                        } else if resp == Resp::data {
                            tx_sh = i_img_data;
                            crc16 = TfCrc::Crc16Byte(crc16, i_img_data);
                            if o_img_off == 9'd511 {
                                resp = Resp::crc_hi;
                            } else {
                                o_img_off = o_img_off + 1;
                            }
                        } else if resp == Resp::crc_hi {
                            tx_sh = crc16[15:8] ^ {7'b0000000, i_cfg_corrupt_crc};
                            resp  = Resp::crc_lo;
                        } else if resp == Resp::crc_lo {
                            tx_sh = crc16[7:0];
                            resp  = Resp::none;
                        } else if resp == Resp::wr_pre {
                            tx_sh = '1; // データ受信中
                        } else if resp == Resp::wr_resp {
                            // データ応答トークン (xxx0_0101 = accepted)
                            if i_cfg_wr_err {
                                tx_sh = 8'h0d; // write error
                            } else if wr_crc_ok {
                                tx_sh = 8'h05;
                            } else {
                                tx_sh = 8'h0b; // CRC error
                            }
                            busy_cnt = BusyBytes;
                            resp     = Resp::wr_busy;
                        } else if resp == Resp::wr_busy {
                            if busy_cnt >: 0 {
                                tx_sh    = 8'h00; // ビジー
                                busy_cnt = busy_cnt - 1;
                            } else {
                                tx_sh = '1;
                                resp  = Resp::none;
                            }
                        } else {
                            tx_sh = '1;
                        }
                    } else {
                        tx_sh = {tx_sh[6:0], 1'b1};
                    }
                }
            }
        }
    }
}
