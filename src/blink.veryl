module Blink #(
    param InClkFreq: u32 = 27_000_000,
    param BlinkFreq: u32 = 1         ,
) (
    i_clk: input  clock,
    i_rst: input  reset,
    o_led: output logic,
) {
    const InvCount    : u32                 = InClkFreq / (BlinkFreq * 2);
    const CounterWidth: u32                 = $clog2(InvCount);
    var   counter     : logic<CounterWidth>;

    always_ff (i_clk, i_rst) {
        if_reset {
            counter = 0;
            o_led   = 0;
        } else if counter <: InvCount - 1 {
            counter = counter + 1;
        } else {
            counter = 0;
            o_led   = ~o_led;
        }
    }
}

#[test(test_blink_small)]
module test_blink_small {
    const InClkFreq : u32 = 4;
    const BlinkFreq : u32 = 1;
    const InvCount  : u32 = InClkFreq / (BlinkFreq * 2);
    const InvCountM1: u32 = InvCount - 1;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var led: logic;

    inst dut: Blink #(
        InClkFreq: InClkFreq,
        BlinkFreq: BlinkFreq,
    ) (
        i_clk: clk,
        i_rst: rst,
        o_led: led,
    );

    initial {
        rst.assert();
        $assert (led == 1'b0);

        clk.next(InvCountM1);
        $assert (led == 1'b0);

        clk.next(1);
        $assert (led == 1'b1);

        clk.next(InvCount);
        $assert (led == 1'b0);

        clk.next(InvCount);
        $assert (led == 1'b1);

        $finish();
    }
}

#[test(test_blink_large)]
module test_blink_large {
    const InClkFreq : u32 = 200_000;
    const BlinkFreq : u32 = 1;
    const InvCount  : u32 = InClkFreq / (BlinkFreq * 2);
    const InvCountM1: u32 = InvCount - 1;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var led: logic;

    inst dut: Blink #(
        InClkFreq: InClkFreq,
        BlinkFreq: BlinkFreq,
    ) (
        i_clk: clk,
        i_rst: rst,
        o_led: led,
    );

    initial {
        rst.assert();
        $assert (led == 1'b0);

        clk.next(InvCountM1);
        $assert (led == 1'b0);

        clk.next(1);
        $assert (led == 1'b1);

        clk.next(InvCount);
        $assert (led == 1'b0);

        clk.next(InvCount);
        $assert (led == 1'b1);

        $finish();
    }
}

#[test(test_blink_actual)]
module test_blink_actual {
    const InClkFreq : u32 = 27_000_000;
    const BlinkFreq : u32 = 1;
    const InvCount  : u32 = InClkFreq / (BlinkFreq * 2);
    const InvCountM1: u32 = InvCount - 1;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var led: logic;

    inst dut: Blink (
        i_clk: clk,
        i_rst: rst,
        o_led: led,
    );

    initial {
        rst.assert();
        $assert (led == 1'b0);

        clk.next(InvCountM1);
        $assert (led == 1'b0);

        clk.next(1);
        $assert (led == 1'b1);

        clk.next(InvCount);
        $assert (led == 1'b0);

        clk.next(InvCount);
        $assert (led == 1'b1);

        $finish();
    }
}
