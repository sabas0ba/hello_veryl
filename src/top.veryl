/// トップモジュール (Tang Nano 9K)
///
/// UART エコー + テキストコンソール (LCD) + PSRAM サブシステム + LED 表示の統合．
///
/// ```mermaid
/// flowchart LR
///     PC["PC (COMポート)"] -- uart_rx --> RX["Uart RX"]
///     RX -- "echo" --> ARB["TX arbiter<br>(memtest優先)"]
///     MT["PsramMemtest"] -- "結果1行" --> ARB
///     ARB --> TX["Uart TX"] -- uart_tx --> PC
///     ARB -. "傍受" .-> CON["TextConsole"] --> LCD["5inch LCD"]
///     MT -- AXI4-Lite --> BR["PsramAxiBridge"] --> CTRL["PsramCtrl"]
///     CTRL --> PHY["PsramPhySdr<br>(CK 6.75MHz)"] <--> RAM["内蔵 PSRAM ch0"]
/// ```
///
/// PSRAM サブシステムは i_clk 単一ドメイン (SDR fallback，本文コメント参照)．
/// PsramClkGen (rPLL 54 MHz) は LED 表示のみに残置．
///
/// LED 割当は docs/rtl.md，PSRAM サブシステムは docs/psram.md を参照．
pub module Top #(
    /// オシレータ周波数 [Hz]
    param OscFreq: u32 = 27_000_000,
    /// LED 数
    param NumLeds: u32 = 6,
) (
    i_clk  : input  clock         , /// 27 MHz オシレータ
    i_rst  : input  reset         , /// S1 ボタン (active-low)
    leds   : output logic<NumLeds>, /// LED (active-low，割当は rtl.md)
    uart_tx: output logic         , /// UART TX
    uart_rx: input  logic         , /// UART RX
    // LCD (5inch 800x480 RGB565, DEモード)
    lcd_clk  : output logic   , /// LCD ピクセルクロック (反転出力)
    lcd_de   : output logic   , /// LCD データイネーブル
    lcd_hsync: output logic   , /// LCD 水平同期 (負極性)
    lcd_vsync: output logic   , /// LCD 垂直同期 (負極性)
    lcd_r    : output logic<5>, /// LCD R (RGB565)
    lcd_g    : output logic<6>, /// LCD G (RGB565)
    lcd_b    : output logic<5>, /// LCD B (RGB565)
    // PSRAM (GW1NR-9 内蔵)．ポート名をマジックポート名に一致させることで
    // nextpnr が cst なしで内蔵パッドへ自動配置する (docs/psram.md)
    O_psram_ck     : output logic    <2> , /// PSRAM CK (ch1:ch0)
    O_psram_ck_n   : output logic    <2> , /// PSRAM CK# (差動)
    O_psram_cs_n   : output logic    <2> , /// PSRAM CS#
    O_psram_reset_n: output logic    <2> , /// PSRAM RESET#
    IO_psram_dq    : inout  tri logic<16>, /// PSRAM DQ (ch0=下位8bit)
    IO_psram_rwds  : inout  tri logic<2> , /// PSRAM RWDS (ch0=bit0)
) {
    // UART エコー: RX(source) → TX arbiter → TX(sink)
    inst echo_stream: stream_if; // RX からのエコー経路
    inst tx_stream  : stream_if; // arbiter → TX

    inst uart: Uart #(
        InClkFreq: OscFreq,
        BaudRate : 115200 ,
    ) (
        i_clk    : i_clk      ,
        i_rst    : i_rst      ,
        uart_tx  : uart_tx    ,
        uart_rx  : uart_rx    ,
        tx_stream: tx_stream  ,
        rx_stream: echo_stream,
    );

    // PSRAM クロック生成 (rPLL 27→54 MHz + 位相シフト出力)．
    // SDR fallback phy への切替 (下記) により PSRAM 経路では未使用となり，
    // leds[1] の clk_mem 換算 1 Hz 点滅 (leds[0] と周期比較) と leds[2] の
    // lock 表示 (spike 段2 の実周波数確認) のみに用いる
    var clk_mem   : 'mem  clock;
    var _clk_mem_p: 'memp clock;
    var pll_lock  :       logic;

    inst psram_clkgen: PsramClkGen (
        i_clk                  ,
        o_clk_mem  : clk_mem   ,
        o_clk_mem_p: _clk_mem_p,
        o_lock     : pll_lock  ,
    );

    // PSRAM サブシステム (SDR fallback phy + ctrl + AXI ブリッジ + memtest;
    // docs/psram.md)．memtest が起動時に PSRAM を検査し，結果 1 行を
    // UART/LCD へ報告する．
    //
    // L4 切り分け (IOLOGIC bitstream 実挙動の疑い，実験記録参照) のため，
    // phy は PsramPhySdr (ファブリック FF 駆動，CK 6.75 MHz) を用い，
    // サブシステム全体を i_clk (27 MHz) 単一ドメインで駆動する．PLL/CDC は
    // PSRAM 経路から外れる (CdcHandshake は同一クロックでもそのまま動作する)．
    // ctrl は phy の位相イネーブル ps_en (1/4 レート) で歩調を合わせ，
    // ブリッジへ渡す o_req_ready / o_rsp_valid は ps_en で修飾する
    // (非イネーブルサイクルでの取りこぼし・二重送信防止．ctrl.veryl 参照)
    var ps_pad_ck     : logic              ;
    var ps_pad_ck_n   : logic              ;
    var ps_pad_cs_n   : logic              ;
    var ps_pad_reset_n: logic              ;
    var ps_en         : logic              ;
    var ps_ck_en      : logic              ;
    var ps_cs_n       : logic              ;
    var ps_reset_n    : logic              ;
    var ps_dq_a_o     : logic           <8>;
    var ps_dq_b_o     : logic           <8>;
    var ps_dq_oe      : logic              ;
    var ps_rwds_a_o   : logic              ;
    var ps_rwds_b_o   : logic              ;
    var ps_rwds_oe    : logic              ;
    var ps_dq_a_i     : logic           <8>;
    var ps_dq_b_i     : logic           <8>;
    var ps_rwds_a_i   : logic              ;
    var ps_rwds_b_i   : logic              ;
    var ps_req_valid  : logic              ;
    var ps_req_ready  : logic              ;
    var ps_req        : psram_pkg::req_t   ;
    var ps_rsp_valid  : logic              ;
    var ps_rsp_ready  : logic              ;
    var ps_rsp        : psram_pkg::rsp_t   ;
    var ps_init_done  : logic              ;
    var ps_init_ok    : logic              ;
    var _ps_dq_in_1   : logic           <8>; // ch1 DQ 読み値 (未使用)
    var _ps_rwds_in_1 : logic              ; // ch1 RWDS 読み値 (未使用)

    inst psram_msg: stream_if;
    inst psram_axi: $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>;

    assign psram_axi.awid = 0;
    assign psram_axi.arid = 0;

    inst psram_phy: PsramPhySdr (
        i_clk                          ,
        i_rst                          ,
        o_en         : ps_en           ,
        i_ck_en      : ps_ck_en        ,
        i_cs_n       : ps_cs_n         ,
        i_reset_n    : ps_reset_n      ,
        i_dq_a       : ps_dq_a_o       ,
        i_dq_b       : ps_dq_b_o       ,
        i_dq_oe      : ps_dq_oe        ,
        i_rwds_a     : ps_rwds_a_o     ,
        i_rwds_b     : ps_rwds_b_o     ,
        i_rwds_oe    : ps_rwds_oe      ,
        o_dq_a       : ps_dq_a_i       ,
        o_dq_b       : ps_dq_b_i       ,
        o_rwds_a     : ps_rwds_a_i     ,
        o_rwds_b     : ps_rwds_b_i     ,
        o_pad_ck     : ps_pad_ck       ,
        o_pad_ck_n   : ps_pad_ck_n     ,
        o_pad_cs_n   : ps_pad_cs_n     ,
        o_pad_reset_n: ps_pad_reset_n  ,
        io_pad_dq    : IO_psram_dq[7:0],
        io_pad_rwds  : IO_psram_rwds[0],
    );

    inst psram_ctrl: PsramCtrl #(
        // CS# Low 上限 tCSM 4 µs (CK 6.75 MHz → 148 ns/CK で 24 CK ≈ 3.6 µs)．
        // 検出は IL=3 で 11 CK / POR IL=6 でも 17 CK 付近のため余裕がある
        TimeoutCyc: 24,
    ) (
        i_clk      : i_clk       ,
        i_rst      : i_rst       ,
        i_en       : ps_en       ,
        i_req_valid: ps_req_valid,
        o_req_ready: ps_req_ready,
        i_req      : ps_req      ,
        o_rsp_valid: ps_rsp_valid,
        i_rsp_ready: ps_rsp_ready,
        o_rsp      : ps_rsp      ,
        o_init_done: ps_init_done,
        o_init_ok  : ps_init_ok  ,
        o_ck_en    : ps_ck_en    ,
        o_cs_n     : ps_cs_n     ,
        o_reset_n  : ps_reset_n  ,
        o_dq_a     : ps_dq_a_o   ,
        o_dq_b     : ps_dq_b_o   ,
        o_dq_oe    : ps_dq_oe    ,
        o_rwds_a   : ps_rwds_a_o ,
        o_rwds_b   : ps_rwds_b_o ,
        o_rwds_oe  : ps_rwds_oe  ,
        i_dq_a     : ps_dq_a_i   ,
        i_dq_b     : ps_dq_b_i   ,
        i_rwds_a   : ps_rwds_a_i ,
        i_rwds_b   : ps_rwds_b_i ,
    );

    // ctrl は ps_en のサイクルしか req/rsp を観測しないため，全速で動く
    // CdcHandshake 側の ready/valid 授受を ps_en のサイクルへ限定する
    let ps_req_ready_g: logic = ps_req_ready && ps_en;
    let ps_rsp_valid_g: logic = ps_rsp_valid && ps_en;

    inst psram_bridge: PsramAxiBridge (
        i_clk_axi  : i_clk         ,
        i_rst_axi  : i_rst         ,
        i_clk_mem  : i_clk         ,
        i_rst_mem  : i_rst         ,
        s_axi      : psram_axi     ,
        o_req_valid: ps_req_valid  ,
        i_req_ready: ps_req_ready_g,
        o_req      : ps_req        ,
        i_rsp_valid: ps_rsp_valid_g,
        o_rsp_ready: ps_rsp_ready  ,
        i_rsp      : ps_rsp        ,
    );

    inst psram_memtest: PsramMemtest (
        i_clk                    ,
        i_rst                    ,
        m_axi      : psram_axi   ,
        i_init_done: ps_init_done,
        i_init_ok  : ps_init_ok  ,
        msg        : psram_msg   ,
    );

    // ch0 のみ使用．ch1 は CS#/RESET# 非活性固定，CK は差動アイドル
    // (CK=Low / CK#=High)，DQ/RWDS は入力固定 (High-Z)
    assign O_psram_ck      = {1'b0, ps_pad_ck};
    assign O_psram_ck_n    = {1'b1, ps_pad_ck_n};
    assign O_psram_cs_n    = {1'b1, ps_pad_cs_n};
    assign O_psram_reset_n = {1'b1, ps_pad_reset_n};

    // ch1 側パッドは IOBUF を常時 High-Z で明示インスタンス化する
    // (assign による tristate は yosys-slang が推論できない; docs/psram.md)
    for i in 0..8 :g_psram_dq1 {
        inst pad: $sv::IOBUF (
            O  : _ps_dq_in_1[i]    ,
            IO : IO_psram_dq[i + 8],
            I  : 1'b0              ,
            OEN: 1'b1              ,
        );
    }
    inst u_rwds1_pad: $sv::IOBUF (
        O  : _ps_rwds_in_1   ,
        IO : IO_psram_rwds[1],
        I  : 1'b0            ,
        OEN: 1'b1            ,
    );

    // TX arbiter: memtest メッセージ優先．起動直後に 1 回送出するのみのため
    // エコーとの競合は実用上起きない (競合時はエコー側が待たされる)
    assign tx_stream.valid   = psram_msg.valid || echo_stream.valid;
    assign tx_stream.data    = if psram_msg.valid ? psram_msg.data : echo_stream.data;
    assign psram_msg.ready   = tx_stream.ready;
    assign echo_stream.ready = tx_stream.ready && !psram_msg.valid;

    // LCD: UART TXへ流れるバイト列を傍受してテキスト表示 (白文字/黒背景)
    var vt_de    : logic    ;
    var vt_hsync : logic    ;
    var vt_vsync : logic    ;
    var vt_pos_x : logic<10>;
    var vt_pos_y : logic<9> ;
    var _vt_frame: logic    ;
    var px       : logic    ;

    inst video_timing: VideoTiming (
        i_clk           ,
        i_rst           ,
        de   : vt_de    ,
        hsync: vt_hsync ,
        vsync: vt_vsync ,
        frame: _vt_frame,
        pos_x: vt_pos_x ,
        pos_y: vt_pos_y ,
    );

    // handshake成立サイクルを傍受 (TX へ流れる全バイト = spike報告 + エコー)
    let snoop_valid: logic = tx_stream.valid && tx_stream.ready;

    inst console: TextConsole (
        i_clk                       ,
        i_rst                       ,
        i_char_valid: snoop_valid   ,
        i_char      : tx_stream.data,
        i_de        : vt_de         ,
        i_hsync     : vt_hsync      ,
        i_vsync     : vt_vsync      ,
        i_pos_x     : vt_pos_x      ,
        i_pos_y     : vt_pos_y      ,
        o_de        : lcd_de        ,
        o_hsync     : lcd_hsync     ,
        o_vsync     : lcd_vsync     ,
        o_pixel     : px            ,
    );

    // 画素合成: 文字前景=白
    assign lcd_r = if px ? 5'h1f : 0;
    assign lcd_g = if px ? 6'h3f : 0;
    assign lcd_b = if px ? 5'h1f : 0;

    // パネルはDCLK立上りでデータをラッチするため，反転出力でデータ遷移と
    // サンプリングエッジを半周期ずらす
    assign lcd_clk = ~i_clk;

    // LED 割当 (active-low):
    //   leds[0]: 1 Hz 点滅 (27 MHz 基準)
    //   leds[1]: 1 Hz 点滅 (clk_mem 54 MHz 換算．leds[0] と同周期なら PLL 正常)
    //   leds[2]: PLL lock (点灯=ロック)
    //   leds[3]: 2 Hz 点滅 (生存表示)
    //   leds[4]: UART RX アクティビティ / leds[5]: UART TX アクティビティ
    inst blink_ref: Blink #(
        InClkFreq: OscFreq,
        BlinkFreq: 1      ,
    ) (
        i_clk: i_clk  ,
        i_rst: i_rst  ,
        o_led: leds[0],
    );

    // clk_mem ドメインの点滅．交差は (1) 非同期リセットの共有 (アサートのみ
    // 使用)，(2) LED パッドへの出力，のみで観測は目視のため許容する
    unsafe (cdc) {
        inst blink_mem: Blink #(
            InClkFreq: 54_000_000,
            BlinkFreq: 1         ,
        ) (
            i_clk: clk_mem,
            i_rst: i_rst  ,
            o_led: leds[1],
        );
    }

    assign leds[2] = ~pll_lock;

    inst blink_alive: Blink #(
        InClkFreq: OscFreq,
        BlinkFreq: 2      ,
    ) (
        i_clk: i_clk  ,
        i_rst: i_rst  ,
        o_led: leds[3],
    );

    // UART TX/RX インジケータ (ボードに専用 LED がないため LED を割当)．
    // ラインの Low (start bit 等) を検出して 100 ms 保持する．
    // uart_rx は非同期入力だが，LED 保持カウンタのリロード条件のみに
    // 使うため同期化は省略する (メタステーブルの影響は視認不能)
    var rx_act: logic;
    var tx_act: logic;

    inst rx_activity: ActivityLed (
        i_clk             ,
        i_rst             ,
        i_active: ~uart_rx,
        o_on    : rx_act  ,
    );
    inst tx_activity: ActivityLed (
        i_clk             ,
        i_rst             ,
        i_active: ~uart_tx,
        o_on    : tx_act  ,
    );
    assign leds[4] = ~rx_act;
    assign leds[5] = ~tx_act;
}
