module Top #(
    param OscFreq: u32 = 27_000_000,
    param NumLeds: u32 = 6         ,
) (
    i_clk  : input  clock         ,
    i_rst  : input  reset         ,
    leds   : output logic<NumLeds>,
    uart_tx: output logic         ,
    uart_rx: input  logic         ,
    // LCD (5inch 800x480 RGB565, DEモード)
    lcd_clk  : output logic   ,
    lcd_de   : output logic   ,
    lcd_hsync: output logic   ,
    lcd_vsync: output logic   ,
    lcd_r    : output logic<5>,
    lcd_g    : output logic<6>,
    lcd_b    : output logic<5>,
) {
    // UART Loopback Test: 受信バイトをそのまま送り返す
    // RX(source)がdata/valid，TX(sink)がreadyを駆動するため1本のstream_ifで直結できる
    inst echo_stream: stream_if;

    inst uart: Uart #(
        InClkFreq: OscFreq,
        BaudRate : 115200 ,
    ) (
        i_clk    : i_clk      ,
        i_rst    : i_rst      ,
        uart_tx  : uart_tx    ,
        uart_rx  : uart_rx    ,
        tx_stream: echo_stream,
        rx_stream: echo_stream,
    );

    // LCD: 時間で流れるRGBグラデーションパターン
    // R=x+frame (横方向へ流れる), G=y (縦グラデ), B=frame (全面で明滅)
    var lcd_pos_x    : logic<10>;
    var lcd_pos_y    : logic<9> ;
    var lcd_frame    : logic    ;
    var frame_counter: logic<8> ;

    always_ff (i_clk, i_rst) {
        if_reset {
            frame_counter = 0;
        } else if lcd_frame {
            frame_counter = frame_counter + 1;
        }
    }

    let grad_r: logic<8> = lcd_pos_x[7:0] + frame_counter;
    let grad_g: logic<8> = lcd_pos_y[7:0];
    let grad_b: logic<8> = frame_counter;

    inst video_timing: VideoTiming (
        i_clk            ,
        i_rst            ,
        de   : lcd_de    ,
        hsync: lcd_hsync ,
        vsync: lcd_vsync ,
        frame: lcd_frame ,
        pos_x: lcd_pos_x ,
        pos_y: lcd_pos_y ,
    );

    // 画素合成: 8bit/chのパターンをde区間のみRGB565へ丸めて出力
    assign lcd_r = if lcd_de ? grad_r[7:3] : 0;
    assign lcd_g = if lcd_de ? grad_g[7:2] : 0;
    assign lcd_b = if lcd_de ? grad_b[7:3] : 0;

    // パネルはDCLK立上りでデータをラッチするため，反転出力でデータ遷移と
    // サンプリングエッジを半周期ずらす
    assign lcd_clk = ~i_clk;

    // LED Blink Test
    for i in 0..NumLeds :g_led {
        inst blink: Blink #(
            InClkFreq: OscFreq,
            BlinkFreq: i + 1,
        ) (
            i_clk: i_clk  ,
            i_rst: i_rst  ,
            o_led: leds[i],
        );
    }
}
