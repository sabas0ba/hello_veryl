/// トップモジュール (Tang Nano 9K)
///
/// UART エコー + テキストコンソール (LCD) + PSRAM サブシステム
/// + TF カードテキスト表示デモ + LED 表示の統合．
///
/// ```mermaid
/// flowchart LR
///     PC["PC (COMポート)"] -- uart_rx --> RX["Uart RX"]
///     RX -- "echo" --> ARB["TX arbiter<br>(memtest &gt; TF &gt; echo)"]
///     MT["PsramMemtest"] -- "結果1行" --> ARB
///     DEMO["TfImageDemo"] -- "報告行" --> ARB
///     FAT["Fat32Reader"] --> DEMO
///     TFC["TfCtrl"] --> FAT
///     ARB --> TX["Uart TX"] -- uart_tx --> PC
///     ARB -. "傍受" .-> CON["TextConsole"] --> LCD["5inch LCD"]
///     MT -- AXI4-Lite --> ARB2["PsramAxiArb2 x2"] --> PS["PsramSubsystem<br>(rPLL + bridge + ctrl + phy)"]
///     PS <--> RAM["内蔵 PSRAM ch0"]
///     DEMO -- "AXI4-Lite W" --> ARB2
///     SC["ImageScanout"] -- "AXI4-Lite R" --> ARB2
///     SC -- RGB565 --> LCD
///     TFC <--> TF["TF カード (SPI)"]
/// ```
///
/// PSRAM サブシステム (phy/ctrl) は clk_mem (rPLL 54 MHz) ドメインで動作し，
/// AXI 側 (memtest) とはブリッジ内 CdcHandshake で交差する．
/// phy は SDR fallback (IOLOGIC 不使用．apicula ODDR の実挙動により DDR phy は
/// 保留中．docs/psram.md「apicula ODDR 実挙動の調査」参照)．
///
/// TX アービタは memtest > TF デモ > エコーの固定優先度とし，行の混在を避けるため
/// TF デモは memtest の報告が完了してから起動する (下記 psram_msg_done)．
/// TF カードのブリングアップ時は TfSpikeInit (Top 非接続の spike) を
/// 本デモ一式と差し替えて使う (docs/tfcard.md「spike の構成」)．
///
/// LED 割当は docs/rtl.md，PSRAM サブシステムは docs/psram.md，
/// TF カードサブシステムは docs/tfcard.md を参照．
pub module Top #(
    /// オシレータ周波数 [Hz]
    param OscFreq: u32 = 27_000_000,
    /// LED 数
    param NumLeds: u32 = 6,
) (
    i_clk  : input  clock         , /// 27 MHz オシレータ
    i_rst  : input  reset         , /// S1 ボタン (active-low)
    leds   : output logic<NumLeds>, /// LED (active-low，割当は rtl.md)
    uart_tx: output logic         , /// UART TX
    uart_rx: input  logic         , /// UART RX
    // LCD (5inch 800x480 RGB565, DEモード)
    lcd_clk  : output logic   , /// LCD ピクセルクロック (反転出力)
    lcd_de   : output logic   , /// LCD データイネーブル
    lcd_hsync: output logic   , /// LCD 水平同期 (負極性)
    lcd_vsync: output logic   , /// LCD 垂直同期 (負極性)
    lcd_r    : output logic<5>, /// LCD R (RGB565)
    lcd_g    : output logic<6>, /// LCD G (RGB565)
    lcd_b    : output logic<5>, /// LCD B (RGB565)
    // TF カードスロット (SPI モード，docs/tfcard.md)
    tf_sclk: output logic, /// TF SCK
    tf_mosi: output logic, /// TF MOSI (CMD)
    tf_cs_n: output logic, /// TF CS# (DAT3)
    tf_miso: input  logic, /// TF MISO (DAT0)
    // PSRAM (GW1NR-9 内蔵)．ポート名をマジックポート名に一致させることで
    // nextpnr が cst なしで内蔵パッドへ自動配置する (docs/psram.md)
    O_psram_ck     : output logic    <2> , /// PSRAM CK (ch1:ch0)
    O_psram_ck_n   : output logic    <2> , /// PSRAM CK# (差動)
    O_psram_cs_n   : output logic    <2> , /// PSRAM CS#
    O_psram_reset_n: output logic    <2> , /// PSRAM RESET#
    IO_psram_dq    : inout  tri logic<16>, /// PSRAM DQ (ch0=下位8bit)
    IO_psram_rwds  : inout  tri logic<2> , /// PSRAM RWDS (ch0=bit0)
) {
    // UART エコー: RX(source) → TX arbiter → TX(sink)
    inst echo_stream: stream_if; // RX からのエコー経路
    inst tx_stream  : stream_if; // arbiter → TX

    inst uart: Uart #(
        InClkFreq: OscFreq,
        BaudRate : 115200 ,
    ) (
        i_clk    : i_clk      ,
        i_rst    : i_rst      ,
        uart_tx  : uart_tx    ,
        uart_rx  : uart_rx    ,
        tx_stream: tx_stream  ,
        rx_stream: echo_stream,
    );

    inst psram_msg: stream_if;
    // AXI4-Lite は 3 マスタ (memtest / 画像ローダ / スキャンアウト) を
    // PsramAxiArb2 の 2 段で優先度合成してブリッジへ渡す
    // (docs/tfcard.md「画像表示デモ仕様」)
    inst mt_axi   : $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>; // memtest
    inst ld_axi   : $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>; // 画像ローダ
    inst sc_axi   : $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>; // スキャンアウト
    inst mid_axi  : $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>; // 前段アービタ出力
    inst psram_axi: $std::axi4_lite_if::<$std::axi4_lite_pkg::<22, 4, 1>>; // ブリッジへ

    assign mt_axi.awid    = 0;
    assign mt_axi.arid    = 0;
    assign ld_axi.awid    = 0;
    assign ld_axi.arid    = 0;
    assign sc_axi.awid    = 0;
    assign sc_axi.arid    = 0;
    assign mid_axi.awid   = 0;
    assign mid_axi.arid   = 0;
    assign psram_axi.awid = 0;
    assign psram_axi.arid = 0;

    inst psram_arb_a: PsramAxiArb2 (
        i_clk         ,
        i_rst         ,
        m0   : mt_axi , // memtest 優先
        m1   : ld_axi ,
        s    : mid_axi,
    );

    inst psram_arb_b: PsramAxiArb2 (
        i_clk           ,
        i_rst           ,
        m0   : mid_axi  ,
        m1   : sc_axi   , // スキャンアウトは最下位
        s    : psram_axi,
    );

    // PSRAM の物理層・コントローラ・CDC ブリッジ・内蔵パッドは
    // PsramSubsystem に閉じ込める．アービタと memtest は利用側の構成要素として
    // Top に残し，memtest > loader > scanout の優先順位を維持する
    var ps_clk_mem  : 'mem clock;
    var ps_init_done:      logic;
    var ps_init_ok  :      logic;
    var ps_pll_lock :      logic;

    inst psram: PsramSubsystem (
        i_clk                        ,
        i_rst                        ,
        s_axi          : psram_axi   ,
        o_clk_mem      : ps_clk_mem  ,
        o_init_done    : ps_init_done,
        o_init_ok      : ps_init_ok  ,
        o_pll_lock     : ps_pll_lock ,
        O_psram_ck                   ,
        O_psram_ck_n                 ,
        O_psram_cs_n                 ,
        O_psram_reset_n              ,
        IO_psram_dq                  ,
        IO_psram_rwds                ,
    );

    inst psram_memtest: PsramMemtest (
        i_clk                    ,
        i_rst                    ,
        m_axi      : mt_axi      ,
        i_init_done: ps_init_done,
        i_init_ok  : ps_init_ok  ,
        msg        : psram_msg   ,
    );

    // TF カードテキスト表示デモ: 初期化報告行 + ルート最初の *.TXT の内容を
    // 送出する (TfCtrl → Fat32Reader → TfTextDemo，docs/tfcard.md)
    inst tf_blk_st: stream_if; // TfCtrl → Fat32Reader
    inst tf_f_st  : stream_if; // Fat32Reader → TfTextDemo
    inst tf_msg   : stream_if; // TfTextDemo → TX アービタ

    var tf_blk_req_valid: logic             ;
    var tf_blk_req_lba  : logic         <32>;
    var tf_blk_req_ready: logic             ;
    var tf_init_done    : logic             ;
    var tf_init_err     : TfTypes::Error    ;
    var tf_blk_done     : logic             ;
    var tf_blk_err      : TfTypes::Error    ;

    var tf_freq_valid : logic               ;
    var tf_freq_name  : logic           <88>;
    var tf_freq_offset: logic           <32>;
    var tf_freq_len   : logic           <32>;
    var tf_freq_ready : logic               ;
    var tf_f_done     : logic               ;
    var tf_f_err      : TfTypes::FsError    ;
    var _tf_f_size    : logic           <32>; // デモでは未使用

    inst tf_ctrl: TfCtrl (
        i_clk                        ,
        i_rst                        ,
        i_req_valid: tf_blk_req_valid,
        i_req_lba  : tf_blk_req_lba  ,
        o_req_ready: tf_blk_req_ready,
        o_init_done: tf_init_done    ,
        o_init_err : tf_init_err     ,
        o_done     : tf_blk_done     ,
        o_err      : tf_blk_err      ,
        data       : tf_blk_st       ,
        i_req_write: 1'b0            ,
        i_wr_valid : 1'b0            ,
        i_wr_data  : 8'b0            ,
        o_wr_ready : _               ,
        o_sclk     : tf_sclk         ,
        o_mosi     : tf_mosi         ,
        o_cs_n     : tf_cs_n         ,
        i_miso     : tf_miso         ,
    );

    inst tf_fat: Fat32Reader (
        i_clk                         ,
        i_rst                         ,
        i_req_valid : tf_freq_valid   ,
        i_req_name  : tf_freq_name    ,
        i_req_offset: tf_freq_offset  ,
        i_req_len   : tf_freq_len     ,
        o_req_ready : tf_freq_ready   ,
        o_done      : tf_f_done       ,
        o_err       : tf_f_err        ,
        o_file_size : _tf_f_size      ,
        data        : tf_f_st         ,
        o_blk_valid : tf_blk_req_valid,
        o_blk_lba   : tf_blk_req_lba  ,
        i_blk_ready : tf_blk_req_ready,
        i_blk_done  : tf_blk_done     ,
        i_blk_err   : tf_blk_err      ,
        blk         : tf_blk_st       ,
    );

    // memtest の報告行と TF デモの出力が混ざらないよう，memtest の 1 行が
    // 出終わってからデモを起動する (msg.valid は行の途中で落ちない)
    var psram_msg_started: logic;
    var psram_msg_done   : logic;

    always_ff (i_clk, i_rst) {
        if_reset {
            psram_msg_started = 0;
            psram_msg_done    = 0;
        } else {
            if psram_msg.valid && psram_msg.ready {
                psram_msg_started = 1;
            }
            if psram_msg_started && !psram_msg.valid {
                psram_msg_done = 1;
            }
        }
    }

    var tf_img_done: logic;

    inst tf_demo: TfImageDemo (
        i_clk                                       ,
        i_rst                                       ,
        i_init_done : tf_init_done && psram_msg_done,
        i_init_err  : tf_init_err                   ,
        o_req_valid : tf_freq_valid                 ,
        o_req_name  : tf_freq_name                  ,
        o_req_offset: tf_freq_offset                ,
        o_req_len   : tf_freq_len                   ,
        i_req_ready : tf_freq_ready                 ,
        i_done      : tf_f_done                     ,
        i_err       : tf_f_err                      ,
        fdat        : tf_f_st                       ,
        msg         : tf_msg                        ,
        m_axi       : ld_axi                        ,
        o_img_done  : tf_img_done                   ,
    );

    // TX arbiter: memtest > TF デモ > エコーの優先順位．いずれも
    // リセット直後のみ送出するためエコーとの競合は実用上起きない
    // (競合時は下位側が待たされる)．TF デモのファイル転送中の
    // ブロック間ギャップではエコーが割り込みうるが，デモ用途では許容する
    assign tx_stream.valid   = psram_msg.valid || tf_msg.valid || echo_stream.valid;
    assign tx_stream.data    = if psram_msg.valid ? psram_msg.data : if tf_msg.valid ? tf_msg.data : echo_stream.data;
    assign psram_msg.ready   = tx_stream.ready;
    assign tf_msg.ready      = tx_stream.ready && !psram_msg.valid;
    assign echo_stream.ready = tx_stream.ready && !psram_msg.valid && !tf_msg.valid;

    // LCD: UART TXへ流れるバイト列を傍受してテキスト表示 (白文字/黒背景)
    var vt_de   : logic    ;
    var vt_hsync: logic    ;
    var vt_vsync: logic    ;
    var vt_pos_x: logic<10>;
    var vt_pos_y: logic<9> ;
    var vt_frame: logic    ;
    var px      : logic    ;

    inst video_timing: VideoTiming (
        i_clk          ,
        i_rst          ,
        de   : vt_de   ,
        hsync: vt_hsync,
        vsync: vt_vsync,
        frame: vt_frame,
        pos_x: vt_pos_x,
        pos_y: vt_pos_y,
    );

    // handshake成立サイクルを傍受 (TX へ流れる全バイト = spike報告 + エコー)
    let snoop_valid: logic = tx_stream.valid && tx_stream.ready;

    inst console: TextConsole (
        i_clk                       ,
        i_rst                       ,
        i_char_valid: snoop_valid   ,
        i_char      : tx_stream.data,
        i_de        : vt_de         ,
        i_hsync     : vt_hsync      ,
        i_vsync     : vt_vsync      ,
        i_pos_x     : vt_pos_x      ,
        i_pos_y     : vt_pos_y      ,
        o_de        : lcd_de        ,
        o_hsync     : lcd_hsync     ,
        o_vsync     : lcd_vsync     ,
        o_pixel     : px            ,
    );

    // 画素合成: 文字前景=白
    // 画像レイヤ: PSRAM のフレームバッファを 8x8 複製で背景に描く
    // (docs/tfcard.md「画像表示デモ仕様」)．文字は最前面に白で重ねる
    var img_rgb: logic<16>;

    inst image_scanout: ImageScanout (
        i_clk                    ,
        i_rst                    ,
        i_en   : tf_img_done     ,
        i_frame: vt_frame        ,
        i_de   : vt_de           ,
        i_pos_x: {2'b0, vt_pos_x},
        m_axi  : sc_axi          ,
        o_rgb  : img_rgb         ,
    );

    assign lcd_r = if px ? 5'h1f : img_rgb[15:11];
    assign lcd_g = if px ? 6'h3f : img_rgb[10:5];
    assign lcd_b = if px ? 5'h1f : img_rgb[4:0];

    // パネルはDCLK立上りでデータをラッチするため，反転出力でデータ遷移と
    // サンプリングエッジを半周期ずらす
    assign lcd_clk = ~i_clk;

    // LED 割当 (active-low):
    //   leds[0]: 1 Hz 点滅 (27 MHz 基準)
    //   leds[1]: 1 Hz 点滅 (clk_mem 54 MHz 換算．leds[0] と同周期なら PLL 正常)
    //   leds[2]: PLL lock (点灯=ロック)
    //   leds[3]: 2 Hz 点滅 (生存表示)
    //   leds[4]: UART RX アクティビティ / leds[5]: UART TX アクティビティ
    inst blink_ref: Blink #(
        InClkFreq: OscFreq,
        BlinkFreq: 1      ,
    ) (
        i_clk: i_clk  ,
        i_rst: i_rst  ,
        o_led: leds[0],
    );

    // clk_mem ドメインの点滅．交差は (1) 非同期リセットの共有 (アサートのみ
    // 使用)，(2) LED パッドへの出力，のみで観測は目視のため許容する
    unsafe (cdc) {
        inst blink_mem: Blink #(
            InClkFreq: 54_000_000,
            BlinkFreq: 1         ,
        ) (
            i_clk: ps_clk_mem,
            i_rst: i_rst     ,
            o_led: leds[1]   ,
        );
    }

    assign leds[2] = ~ps_pll_lock;

    inst blink_alive: Blink #(
        InClkFreq: OscFreq,
        BlinkFreq: 2      ,
    ) (
        i_clk: i_clk  ,
        i_rst: i_rst  ,
        o_led: leds[3],
    );

    // UART TX/RX インジケータ (ボードに専用 LED がないため LED を割当)．
    // ラインの Low (start bit 等) を検出して 100 ms 保持する．
    // uart_rx は非同期入力だが，LED 保持カウンタのリロード条件のみに
    // 使うため同期化は省略する (メタステーブルの影響は視認不能)
    var rx_act: logic;
    var tx_act: logic;

    inst rx_activity: ActivityLed (
        i_clk             ,
        i_rst             ,
        i_active: ~uart_rx,
        o_on    : rx_act  ,
    );
    inst tx_activity: ActivityLed (
        i_clk             ,
        i_rst             ,
        i_active: ~uart_tx,
        o_on    : tx_act  ,
    );
    assign leds[4] = ~rx_act;
    assign leds[5] = ~tx_act;
}
