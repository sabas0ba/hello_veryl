module Uart #(
    param InClkFreq: u32 = 27_000_000,
    param BaudRate : u32 = 115200    ,
) (
    // Clock/Reset
    i_clk: input clock,
    i_rst: input reset,
    // UART TX/RX pin
    uart_tx: output logic,
    uart_rx: input  logic,
    // TX/RX Data
    tx_stream: modport stream_if::sink  ,
    rx_stream: modport stream_if::source,
) {
    // 四捨五入付きで，1bitあたりのサイクル数算出
    const CycPerBit      : u32 = (InClkFreq + BaudRate / 2) / BaudRate;
    const HalfCycPerBit  : u32 = CycPerBit / 2;
    const CycCounterWidth: u32 = $clog2(CycPerBit);

    // 送信データをtx_streamからtx_dataに転送後，順番にLSB方向にシフトして送信
    const TxDataWithParityWidth: u32                          = 1 + 8 + 1; // [MSB] stop bit + data bit + start bit [LSB]
    const TxDataCounterWidth   : u32                          = $clog2(TxDataWithParityWidth);
    var   is_sending           : lbool                       ;
    var   tx_cyc_counter       : logic<CycCounterWidth>      ;
    var   tx_counter           : logic<TxDataCounterWidth>   ;
    var   tx_data              : logic<TxDataWithParityWidth>;
    assign uart_tx = tx_data[lsb];

    always_ff (i_clk, i_rst) {
        if_reset {
            is_sending      = false;
            tx_cyc_counter  = 0;
            tx_counter      = 0;
            tx_stream.ready = false;
            tx_data         = '1;
        } else if !is_sending {
            // ready & validで送信データFetch
            if !tx_stream.ready {
                tx_stream.ready = true;
            } else if tx_stream.valid {
                tx_stream.ready = false;
                is_sending      = true;
                tx_cyc_counter  = 0;
                tx_counter      = 0;
                tx_data         = {1'b1, tx_stream.data, 1'b0};
            }
        } else {
            // 送信中 (更にcyc_counter分の周期でデータをシフト)
            if tx_counter <: TxDataWithParityWidth {
                if tx_cyc_counter <: CycPerBit - 1 {
                    tx_cyc_counter = tx_cyc_counter + 1;
                } else {
                    // 1文字送信済
                    tx_cyc_counter = 0;
                    tx_counter     = tx_counter + 1;
                    tx_data        = {1'b1, tx_data[msb:lsb + 1]}; // popout LSB
                }
            } else {
                // 全部終わり
                is_sending = false;
            }
        }
    }

    // Start bitを検出後，順番にデータを取り出す．タイミングはStart bit検出タイミングから1/2周期シフトした中央サンプル
    const RxDataWidth       : u32      = 8; // only data bit
    const RxDataCounterWidth: u32      = $clog2(RxDataWidth);
    enum RxState: logic<3> {
        idle,
        wait_d0,
        recv_data,
        push_to_stream,
    }
    var rx_state      : RxState                    ;
    var rx_cyc_counter: logic  <CycCounterWidth>   ;
    var rx_counter    : logic  <RxDataCounterWidth>;
    var rx_data       : logic  <RxDataWidth>       ;
    assign rx_stream.data = rx_data;

    always_ff (i_clk, i_rst) {
        if_reset {
            rx_state        = RxState::idle;
            rx_cyc_counter  = 0;
            rx_counter      = 0;
            rx_data         = 0;
            rx_stream.valid = false;
        } else if rx_state == RxState::idle {
            // uart_rx から start bitが創出されるまで待機
            if uart_rx == 1'b0 {
                rx_state       = RxState::wait_d0;
                rx_cyc_counter = 0;
            }
        } else if rx_state == RxState::wait_d0 {
            // Start bit検出 ~ 1/2周期経過待機してから転送ロジック開始
            if rx_cyc_counter <: HalfCycPerBit - 1 {
                rx_cyc_counter = rx_cyc_counter + 1;
            } else {
                rx_state       = RxState::recv_data;
                rx_cyc_counter = 0;
                rx_counter     = 0;
                rx_data        = 0;
            }
        } else if rx_state == RxState::recv_data {
            // 周期ごとにデータ受信．Startbitは除去済なのでデータだけあればよい
            if rx_counter <: RxDataWidth {
                if rx_cyc_counter <: CycPerBit - 1 {
                    rx_cyc_counter = rx_cyc_counter + 1;
                } else {
                    rx_data        = {uart_rx, rx_data[msb:lsb + 1]}; // push to MSB
                    rx_cyc_counter = 0;
                    rx_counter     = rx_counter + 1;
                }
            } else {
                // データ準備OK
                rx_state        = RxState::push_to_stream;
                rx_stream.valid = true;
            }
        } else if rx_state == RxState::push_to_stream {
            // ready & validで完了 (validはすでに立ててある)
            if rx_stream.ready {
                rx_stream.valid = false;
                rx_state        = RxState::idle;
            }
        }
    }

}

#[test(test_uart_tx_115200)]
module test_uart_tx_115200 {
    const InClkFreq: u32 = 27_000_000;
    const BaudRate : u32 = 115200;
    const CycPerBit: u32 = (InClkFreq + BaudRate / 2) / BaudRate;
    const HalfCyc  : u32 = CycPerBit / 2;
    const MaxWait  : u32 = CycPerBit * 30;
    const GapCyc   : u32 = CycPerBit * 3;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst tx_st: stream_if;
    inst rx_st: stream_if;

    var txd: logic;
    var rxd: logic;
    assign rxd = 1'b1; // RX line idle

    inst dut: Uart #(
        InClkFreq: InClkFreq,
        BaudRate : BaudRate ,
    ) (
        i_clk    : clk  ,
        i_rst    : rst  ,
        uart_tx  : txd  ,
        uart_rx  : rxd  ,
        tx_stream: tx_st,
        rx_stream: rx_st,
    );

    var bytes: logic<8> [6];

    initial {
        bytes[0] = 8'h55; // 単発
        bytes[1] = 8'ha3; // 連続 x3
        bytes[2] = 8'h00;
        bytes[3] = 8'hff;
        bytes[4] = 8'h0f; // 間欠 x2
        bytes[5] = 8'hf0;

        tx_st.valid = 0;
        tx_st.data  = 0;
        rst.assert ();
        $assert    (txd == 1'b1); // idle high

        // ---- 単発 ----
        tx_st.data  = bytes[0];
        tx_st.valid = 1;
        for _w in 0..MaxWait {
            if tx_st.ready == 1'b1 {
                break;
            }
            clk.next(1);
        }
        clk.next   (1); // accept edge
        tx_st.valid = 0;

        clk.next(HalfCyc);
        $assert (txd == 1'b0, "single: start bit");
        for i in 0..8 {
            clk.next(CycPerBit);
            $assert (txd == bytes[0][i], "single: data bit %0d", i);
        }
        clk.next(CycPerBit);
        $assert (txd == 1'b1, "single: stop bit");

        // ---- 連続 (validを保持しback-to-back送信) ----
        tx_st.valid = 1;
        for n in 1..4 {
            tx_st.data = bytes[n];
            for _w in 0..MaxWait {
                if tx_st.ready == 1'b1 {
                    break;
                }
                clk.next(1);
            }
            clk.next(1); // accept edge
            if n == 3 {
                tx_st.valid = 0;
            }

            clk.next(HalfCyc);
            $assert (txd == 1'b0, "burst %0d: start bit", n);
            for i in 0..8 {
                clk.next(CycPerBit);
                $assert (txd == bytes[n][i], "burst %0d: data bit %0d", n, i);
            }
            clk.next(CycPerBit);
            $assert (txd == 1'b1, "burst %0d: stop bit", n);
        }

        // ---- 間欠 (フレーム間にアイドルを挟む) ----
        for n in 4..6 {
            clk.next(GapCyc);
            $assert (txd == 1'b1, "gap %0d: idle", n);

            tx_st.data  = bytes[n];
            tx_st.valid = 1;
            for _w in 0..MaxWait {
                if tx_st.ready == 1'b1 {
                    break;
                }
                clk.next(1);
            }
            clk.next   (1); // accept edge
            tx_st.valid = 0;

            clk.next(HalfCyc);
            $assert (txd == 1'b0, "gap %0d: start bit", n);
            for i in 0..8 {
                clk.next(CycPerBit);
                $assert (txd == bytes[n][i], "gap %0d: data bit %0d", n, i);
            }
            clk.next(CycPerBit);
            $assert (txd == 1'b1, "gap %0d: stop bit", n);
        }

        $finish();
    }
}

#[test(test_uart_tx_9600)]
module test_uart_tx_9600 {
    const InClkFreq: u32 = 27_000_000;
    const BaudRate : u32 = 9600;
    const CycPerBit: u32 = (InClkFreq + BaudRate / 2) / BaudRate;
    const HalfCyc  : u32 = CycPerBit / 2;
    const MaxWait  : u32 = CycPerBit * 30;
    const GapCyc   : u32 = CycPerBit * 3;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst tx_st: stream_if;
    inst rx_st: stream_if;

    var txd: logic;
    var rxd: logic;
    assign rxd = 1'b1; // RX line idle

    inst dut: Uart #(
        InClkFreq: InClkFreq,
        BaudRate : BaudRate ,
    ) (
        i_clk    : clk  ,
        i_rst    : rst  ,
        uart_tx  : txd  ,
        uart_rx  : rxd  ,
        tx_stream: tx_st,
        rx_stream: rx_st,
    );

    var bytes: logic<8> [6];

    initial {
        bytes[0] = 8'h55; // 単発
        bytes[1] = 8'ha3; // 連続 x3
        bytes[2] = 8'h00;
        bytes[3] = 8'hff;
        bytes[4] = 8'h0f; // 間欠 x2
        bytes[5] = 8'hf0;

        tx_st.valid = 0;
        tx_st.data  = 0;
        rst.assert ();
        $assert    (txd == 1'b1); // idle high

        // ---- 単発 ----
        tx_st.data  = bytes[0];
        tx_st.valid = 1;
        for _w in 0..MaxWait {
            if tx_st.ready == 1'b1 {
                break;
            }
            clk.next(1);
        }
        clk.next   (1); // accept edge
        tx_st.valid = 0;

        clk.next(HalfCyc);
        $assert (txd == 1'b0, "single: start bit");
        for i in 0..8 {
            clk.next(CycPerBit);
            $assert (txd == bytes[0][i], "single: data bit %0d", i);
        }
        clk.next(CycPerBit);
        $assert (txd == 1'b1, "single: stop bit");

        // ---- 連続 (validを保持しback-to-back送信) ----
        tx_st.valid = 1;
        for n in 1..4 {
            tx_st.data = bytes[n];
            for _w in 0..MaxWait {
                if tx_st.ready == 1'b1 {
                    break;
                }
                clk.next(1);
            }
            clk.next(1); // accept edge
            if n == 3 {
                tx_st.valid = 0;
            }

            clk.next(HalfCyc);
            $assert (txd == 1'b0, "burst %0d: start bit", n);
            for i in 0..8 {
                clk.next(CycPerBit);
                $assert (txd == bytes[n][i], "burst %0d: data bit %0d", n, i);
            }
            clk.next(CycPerBit);
            $assert (txd == 1'b1, "burst %0d: stop bit", n);
        }

        // ---- 間欠 (フレーム間にアイドルを挟む) ----
        for n in 4..6 {
            clk.next(GapCyc);
            $assert (txd == 1'b1, "gap %0d: idle", n);

            tx_st.data  = bytes[n];
            tx_st.valid = 1;
            for _w in 0..MaxWait {
                if tx_st.ready == 1'b1 {
                    break;
                }
                clk.next(1);
            }
            clk.next   (1); // accept edge
            tx_st.valid = 0;

            clk.next(HalfCyc);
            $assert (txd == 1'b0, "gap %0d: start bit", n);
            for i in 0..8 {
                clk.next(CycPerBit);
                $assert (txd == bytes[n][i], "gap %0d: data bit %0d", n, i);
            }
            clk.next(CycPerBit);
            $assert (txd == 1'b1, "gap %0d: stop bit", n);
        }

        $finish();
    }
}
