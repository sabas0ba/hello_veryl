# FPGA build environment for Tang Nano 9K (yosys / nextpnr-himbaechel / apicula)
# Base image and toolchain archive are pinned (digest / SHA-256); see README.
FROM docker.io/library/debian:13-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# ca-certificates/curl are needed only to fetch the pinned toolchain archive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# OSS CAD Suite 2026-07-20 (SHA-256 cross-checked with the GitHub Releases API
# asset digest; same trust-anchor limitation as noted in README)
RUN curl -fL --proto '=https' --tlsv1.2 \
      -o /tmp/oss-cad-suite.tgz \
      https://github.com/YosysHQ/oss-cad-suite-build/releases/download/2026-07-20/oss-cad-suite-linux-x64-20260720.tgz \
 && echo "ba680b02915bc59da92c64fbbbacd86fd2650f74480503f9d3b6eb47c2ea2a53  /tmp/oss-cad-suite.tgz" | sha256sum -c - \
 && tar -xzf /tmp/oss-cad-suite.tgz -C /opt \
 && rm /tmp/oss-cad-suite.tgz

ENV PATH="/opt/oss-cad-suite/bin:${PATH}"
WORKDIR /work
