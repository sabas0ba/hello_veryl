// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) — TopRv (RV32I ソフトコア) 用
// 既存 Top 用は tangnano9k.cst．こちらは clk/rst/LED/UART のみを使う
// Pin assignments per Sipeed official examples (TangNano-9K-example/led, /uart)
// i_clk   : 27 MHz onboard oscillator
// i_rst   : S1 button, active-low (matches Veryl default reset: async active-low)
// leds    : 6 onboard LEDs, active-low
// uart_tx : FPGA TX -> BL702 -> PC (USB-CDC serial)
// uart_rx : PC -> BL702 -> FPGA RX

IO_LOC  "i_clk" 52;
IO_PORT "i_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "i_rst" 4;
IO_PORT "i_rst" PULL_MODE=UP;

IO_LOC  "leds[0]" 10;
IO_PORT "leds[0]" PULL_MODE=UP DRIVE=8;
IO_LOC  "leds[1]" 11;
IO_PORT "leds[1]" PULL_MODE=UP DRIVE=8;
IO_LOC  "leds[2]" 13;
IO_PORT "leds[2]" PULL_MODE=UP DRIVE=8;
IO_LOC  "leds[3]" 14;
IO_PORT "leds[3]" PULL_MODE=UP DRIVE=8;
IO_LOC  "leds[4]" 15;
IO_PORT "leds[4]" PULL_MODE=UP DRIVE=8;
IO_LOC  "leds[5]" 16;
IO_PORT "leds[5]" PULL_MODE=UP DRIVE=8;

IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
